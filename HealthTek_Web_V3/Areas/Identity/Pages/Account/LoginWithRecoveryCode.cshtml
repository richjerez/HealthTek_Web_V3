@page "~/LoginWithCodes"
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code verification";
}

<div class="container pl-0 pr-0 cardlayout">
    <div class="row justify-content-center">

        <div class="col-xl-10 col-lg-12 col-md-9">

            <div class="card o-hidden border-0 shadow-lg my-5">
                <div class="card-body p-0">
                    <!-- Nested Row within Card Body -->
                    <div class="row">
                        <div class="col-lg-6 d-none d-lg-block bg-recoverycode-image border-right mt-5 mb-5"></div>
                        <div class="col-lg-6">
                            <div class="p-5">
                                <div class="text-center">
                                    <h1 class="h4 text-gray-900">@ViewData["Title"].ToString().ToUpper()</h1>
                                    <hr />
                                    <p>
                                        You have requested to log in with a recovery code. This login will not be remembered until you provide
                                        an authenticator app code at log in or disable 2FA and log in again.
                                    </p>
                                </div>
                                <form method="post" class="user">
                                    <div asp-validation-summary="All" class="text-danger"></div>
                                    <div class="form-group">
                                        <label asp-for="Input.RecoveryCode"></label>
                                        <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" />
                                        <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-user btn-block">Log in</button>
                                </form>
                                <p>
                                    Don't have access to your recovery codes? You can
                                    <a id="2fa-login" asp-page="./LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl">use two-factor authentification</a>.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
