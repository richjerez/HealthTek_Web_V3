@page  "~/ForgotPassword"
@model ForgotPasswordModel
@using HealthTek_Shared_Libraries
@inject SignInManager<AppUser> SignInManager

@{
    ViewData["Title"] = "Forgot your password?";
}
@if (!SignInManager.IsSignedIn(User))
{

    <div class="container pl-0 pr-0 cardlayout">
        <div class="row justify-content-center">

            <div class="col-xl-10 col-lg-12 col-md-9">

                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <!-- Nested Row within Card Body -->
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900">FORGOT PASSWORD?</h1>
                                        <p>Enter your email address below and we'll send you a link to reset your password!</p>
                                        <hr />
                                    </div>                                <form class="user" id="account" method="post">
                                        <div asp-validation-summary="All" class="text-danger"></div>
                                        <div class="form-group">
                                            <input type="email" class="form-control form-control-user"
                                                   id="exampleInputEmail" aria-describedby="emailHelp"
                                                   placeholder="Enter Email Address..." asp-for="Input.Email">
                                        </div>
                                        <div class="form-group" style="text-align: -webkit-center;">
                                            <div class="g-recaptcha" data-sitekey="6LepwB8gAAAAAD0jEIf78qqhuhJ-E1Os4u63s0F-"></div>
                                        </div>
                                        <a onclick="SubmitForm('account')" class="btn btn-primary btn-user btn-block" href="#">
                                            Send Email
                                        </a>
                                    </form>
                                    <hr>
                                    <div class="text-center">
                                        <a class="label" asp-page="./Login">Already have an Account? Sign-In!</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
}
else
{
    <script type="text/javascript">
        window.location.href = "Dashboard";
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
