@page "~/Login"
@model LoginModel
@using HealthTek_Shared_Libraries
@inject SignInManager<AppUser> SignInManager

@{
    ViewData["Title"] = "Log in";
}
@if (!SignInManager.IsSignedIn(User))
{
    <div class="container pl-0 pr-0 cardlayout">
        <div class="row justify-content-center">

            <div class="col-xl-10 col-lg-12 col-md-9">

                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <!-- Nested Row within Card Body -->
                        <div class="row pt-5">
                            <div class="col-lg-12 mb-5">
                                <div class="pl-5 pr-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900">USER SIGN-IN</h1>
                                        <p class="text-muted mb-1">
                                            To login please use the combination username and password!
                                            The automated username is first and last name <code>(i.e., FirstnameLastname)</code>
                                        </p>
                                        <hr class="mt-0">
                                    </div>
                                    <partial name="_StatusMessage" model="@Model.StatusMessage" />
                                    <form class="user mt-5" id="account" method="post">
                                        <div asp-validation-summary="All" class="text-danger"></div>
                                        <div class="form-group">
                                            <input type="text" class="form-control form-control-user"
                                               id="exampleInputEmail" aria-describedby="emailHelp"
                                               placeholder="Enter your username..." asp-for="Input.UserName">
                                        </div>
                                        <div class="form-group">
                                            <input type="password" class="form-control form-control-user"
                                               id="exampleInputPassword" placeholder="Password"
                                               asp-for="Input.Password">
                                        </div>
                                        <div class="ml-3 form-group">
                                            <div class="custom-control custom-checkbox label">
                                                <input type="checkbox" class="custom-control-input" id="customCheck"
                                                   asp-for="Input.RememberMe" onchange="this.value=this.checked">
                                                <label class="custom-control-label" for="customCheck">
                                                    Remember
                                                    Me
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-group" style="text-align: -webkit-center;">
                                            <div class="g-recaptcha" data-sitekey="6LepwB8gAAAAAD0jEIf78qqhuhJ-E1Os4u63s0F-"></div>
                                        </div>
                                        <a onclick="SubmitForm('account')" class="btn btn-primary btn-user btn-block" href="#">
                                            Login
                                        </a>
                                    </form>
                                    <div class="text-center">
                                        <a class="label" id="forgot-password" asp-page="./ForgotPassword">Forgot Password?</a>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <a asp-controller="Home" asp-action="Terms" class="ml-2">
                            <small class="text-xs">Terms of use</small>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
}
else
{
    <script type="text/javascript">
        window.location.href = "Dashboard";
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
