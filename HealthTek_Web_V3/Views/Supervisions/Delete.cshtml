@model HealthTek_Shared_Libraries.Supervisions

<div class="text-center">
    <i class="fas fa-exclamation-triangle fa-5x text-warning pb-2"></i>
    <h5>
        Warning: This will permanently delete all of the information on this for this supervision. Are you sure you want to delete the supervision for client <code>@Html.DisplayFor(model => model.FkAppointments.FkClients.FullName) and 
        @Html.DisplayFor(model => model.FkAppointments.FkEmployees.EmployeeLabel)</code> ?
    </h5>
    <hr />
    <form asp-action="Delete" class="text-right row" asp-route-id="@Model.SupervisionsId">
        <input type="text" class="form-control col-md-7 mt-1 ml-2" id="Name" placeholder="Enter User Name..." name="Name">
        <input type="submit" value="Delete" class="btn btn-danger col-md-4 ml-2 " disabled id="deleteBtn" />
    </form>
</div>
<script>
    $('input[name="Name"]').keyup(function () {
        var Name = @Html.Raw(Json.Serialize(Model.FkAppointments.FkEmployees.EmployeeLabel));
        var name = $(this).val();
        if (Name == name) {
            document.getElementById('deleteBtn').disabled = false;
        } else {
            document.getElementById('deleteBtn').disabled = true;

        }

    });
</script>