@model HealthTek_Shared_Libraries.EmployeesRoleNames

<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Edit" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="EmployeesRoleNamesId" type="hidden" />
                <input asp-for="FkEmployeesId" type="hidden" />
                <div class="form-group">
                    <label asp-for="FkRoleNamesId" class="control-label"></label>
                    <select asp-for="FkRoleNamesId" class="form-control" asp-items="ViewBag.FkRoleNamesId" onchange="getFields()"></select>
                </div>
                <div style="display:none" id="super">
                    <div class="form-group">
                        <label asp-for="SupervisorNumber" class="control-label"></label>
                        <input asp-for="SupervisorNumber" class="form-control" />
                        <span asp-validation-for="SupervisorNumber" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SupervisionStartDate" class="control-label"></label>
                        <input asp-for="SupervisionStartDate" class="form-control" />
                        <span asp-validation-for="SupervisionStartDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SupervisionEndDate" class="control-label"></label>
                        <input asp-for="SupervisionEndDate" class="form-control" />
                        <span asp-validation-for="SupervisionEndDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group float-right mb-0">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

