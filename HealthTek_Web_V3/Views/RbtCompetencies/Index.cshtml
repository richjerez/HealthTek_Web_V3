@model IEnumerable<HealthTek_Shared_Libraries.Appointments>

<div class="table-responsive">
    <table class="table" id="dataTable3" width="100%" cellspacing="0">
        <thead class="bg-primary text-white">
            <tr>
                <th>
                    DOS
                </th>
                <th>
                    Employee
                </th>
                <th data-orderable="false"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Select(m => m.Supervisions).Select(m => m.FkRbtCompetencies).ToList())
            {
                <tr ondblclick="AddEditElements('@item.RbtCompetenciesId', 'RbtCompetencies')">
                    <td>
                        @Html.DisplayFor(modelItem => item.CompetencyDate)
                    </td>
                    <td>
                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@item.Supervisions.FkAppointments.FkEmployeesId">
                            @Html.DisplayFor(modelItem => item.Supervisions.FkAppointments.FkEmployees.FullName)
                        </a>
                    </td>
                    <td class="text-right">
                        <button onclick="DeleteElement('@item.RbtCompetenciesId', 'RbtCompetencies')" href="#" class="btn btn-outline-danger ">
                            <span class="text">
                                <i class="fa fa-trash"></i>
                            </span>
                        </button>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
