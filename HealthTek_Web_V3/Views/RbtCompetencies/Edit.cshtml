@model HealthTek_Shared_Libraries.RbtCompetencies
<style>
    datalist {
        display: flex;
        justify-content: space-between;
        color: red;
        width: 100%;
    }

    .range {
        width: 100%;
    }
</style>
<div class="card shadow p-4">
    <div class="row">
        <div class="col-md-12">
            @using (Html.BeginForm("Edit", "RbtCompetencies", FormMethod.Post, new { onsubmit = "return jQueryAjaxPost(this);" }))
            {
                var step = 0;
                var border = "";
                <div class="row">
                    @for (int i = 0; i < Model.RbtCompTrainings.Count; i++)
                    {
                        switch(step){
                            case 0:
                                border = "border-right pr-4";
                                step++;
                                break;
                            default:
                                border = "pl-4";
                                step = 0;
                                break;
                        }
                        <div class="col-lg-6 @border">
                            <input type="hidden" asp-for="@Model.RbtCompTrainings[i].RbtCompTrainingsId" />
                            <input type="hidden" asp-for="@Model.RbtCompTrainings[i].FkRbtCompetenciesId" />
                            <input type="hidden" asp-for="@Model.RbtCompTrainings[i].TrainingItem" />
                            <span>@Model.RbtCompTrainings[i].TrainingItem</span>

                            @Html.TextBoxFor(m => m.RbtCompTrainings[i].CompetencyLevel,
                    new { @class = "range", @list="tickmarks-" + i, @type="range", @step="25"})
                            <datalist id="tickmarks-@i">
                                <option value="0" label="0%"></option>
                                <option value="25" label="25%"></option>
                                <option value="50" label="50%"></option>
                                <option value="75" label="75%"></option>
                                <option value="100" label="100%"></option>
                            </datalist>
                            <div class="form-group">
                                @Html.LabelFor(m => m.RbtCompTrainings[i].Comment)
                                @Html.TextAreaFor(m => m.RbtCompTrainings[i].Comment, new { @class = "form-control" })
                            </div>
                        </div>
                    }

                </div>
                await Html.RenderPartialAsync("~/Views/Shared/_SubmitButton.cshtml", "Save");
            }
        </div>
    </div>
</div>