@model HealthTek_Shared_Libraries.PreferencesCatalog

<div class="container">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-12">
                    <form asp-action="Create" onsubmit="return jQueryAjaxPost(this);">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="Preference" class="control-label"></label>
                            <input asp-for="Preference" class="form-control" asp-items="ViewBag.CodeRateType" />
                            <span asp-validation-for="Preference" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Create" class="btn btn-primary float-right" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
