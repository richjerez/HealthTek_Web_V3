@model HealthTek_Shared_Libraries.CaregiverFeedback

<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Edit" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="CaregiverFeedbackId"/>
                <div class="form-group">
                    <label asp-for="Feedback" class="control-label"></label>
                    <textarea asp-for="Feedback" class="form-control"></textarea>
                    <span asp-validation-for="Feedback" class="text-danger"></span>
                </div>
                <div class="text-right">
                    <input type="submit" value="Create" class="btn btn-primary float-right" />
                </div>
            </form>
        </div>
    </div>
</div>
