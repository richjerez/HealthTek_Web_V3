@model HealthTek_Shared_Libraries.RoleNames

<div class="text-center">
    <i class="fas fa-exclamation-triangle fa-5x text-warning pb-2"></i>
    <h5>
        Warning: Deleting this role can cause the application to not display certain views. Are you sure you want to delete the role <code>@Html.DisplayFor(model => model.RoleName)</code> ?
    </h5>
    <hr />
    <form asp-action="Delete" class="text-right row" asp-route-id="@Model.RoleNamesId">
        <input type="text" class="form-control col-md-7 mt-1 ml-2" id="Name" placeholder="Enter Role Name..." name="Name">
        <input type="submit" value="Delete" class="btn btn-danger col-md-4 ml-2 " disabled id="deleteBtn" />
    </form>
</div>
<script>
    $('input[name="Name"]').keyup(function () {
        var walletName = @Html.Raw(Json.Serialize(Model.RoleName));
        var name = $(this).val();
        if (walletName == name) {
            document.getElementById('deleteBtn').disabled = false;
        } else {
            document.getElementById('deleteBtn').disabled = true;

        }
    });
</script>