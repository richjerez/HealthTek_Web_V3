@model HealthTek_Shared_Libraries.BaAssessmentsInterventions
<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="BaAssessmentsInterventionsId" type="hidden" />
                <input asp-for="FkBaAssessmentsId" type="hidden" />
                <div class="form-group">
                    <label asp-for="FkInterventionsId" class="control-label"></label>
                    <select asp-for="FkInterventionsId" class="ModalSelect" asp-items="ViewBag.FkInterventionsId"></select>
                </div>
                <div class="form-group">
                    <label asp-for="InterventionName" class="control-label"></label>
                    <input asp-for="InterventionName" class="form-control" />
                    <span asp-validation-for="InterventionName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="InterventionComment" class="control-label"></label>
                    <textarea asp-for="InterventionComment" class="form-control"></textarea>
                    <span asp-validation-for="InterventionComment" class="text-danger"></span>
                </div>
                <div class="form-group text-right mb-0">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>
