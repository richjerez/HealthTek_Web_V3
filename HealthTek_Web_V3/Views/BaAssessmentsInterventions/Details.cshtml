@model HealthTek_Shared_Libraries.BaAssessmentsInterventions

<div class="col-lg-4">
    <div class="status status-blue p-3" style="border-radius:5px">
        <a onclick="DeleteElement(@Model.BaAssessmentsInterventionsId, 'BaAssessmentsInterventions')"
           class="btn btn-danger btn-xs float-right">
            <i class="fas fa-trash"></i>
        </a>
        <a onclick="AddEditElements(@Model.BaAssessmentsInterventionsId, 'BaAssessmentsInterventions', false,@Model.FkBaAssessmentsId)"
           class="btn btn-primary btn-xs mr-1 float-right" tabindex="0">
            <i class="fas fa-edit"></i>
        </a>

        <small class="font-weight-bold">Intervention</small>
        <span class="d-block">@Model.FkInterventions.InterventionName</span>
        <small class="font-weight-bold">Description</small>
        <span class="d-block">@Model.FkInterventions.InterventionDescription</span>
        <small class="font-weight-bold">Comment</small>
        <span class="d-block">@Model.InterventionComment</span>
        <hr />
        @if (Model.FkCaregiverTrainingGoals != null)
        {
            var item = Model.FkCaregiverTrainingGoals;
            item.GoalType = "CTG-I";
            await Html.RenderPartialAsync("~/Views/CaregiverTrainingGoals/Details.cshtml", item);

        }
        else
        {
            <div class="row">
                <div class="col-lg-12">
                    <button type="button" onclick="AddEditElements(0, 'CaregiverTrainingGoals',false, @Model.BaAssessmentsInterventionsId, 'Interventions')"
                        class="d-none d-sm-inline-block btn btn-xs btn-primary shadow-sm btn-icon-split d-print-none float-right">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus fa-sm text-white-50"></i>
                        </span>
                        <span class="text align-self-md-center">New Training Goal</span>
                    </button>
                    <h5 class="font-weight-bold">Caregiver Training Goals</h5>
                </div>
            </div>

        }

    </div>

</div>
