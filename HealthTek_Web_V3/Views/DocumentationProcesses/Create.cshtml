@model HealthTek_Shared_Libraries.DocumentationProcess

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create</title>
</head>
<body>

<h4>DocumentationProcess</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Role" class="control-label"></label>
                <input asp-for="Role" class="form-control" />
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FkEmployeesId" class="control-label"></label>
                <select asp-for="FkEmployeesId" class ="form-control" asp-items="ViewBag.FkEmployeesId" data-live-search="true"></select>
            </div>
            <div class="form-group">
                <label asp-for="FkUploadedById" class="control-label"></label>
                <select asp-for="FkUploadedById" class ="form-control" asp-items="ViewBag.FkUploadedById" data-live-search="true"></select>
            </div>
            <div class="form-group">
                <label asp-for="FkRoleDocsCatalogId" class="control-label"></label>
                <input asp-for="FkRoleDocsCatalogId" class="form-control" />
                <span asp-validation-for="FkRoleDocsCatalogId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FkDocumentsId" class="control-label"></label>
                <select asp-for="FkDocumentsId" class ="form-control" asp-items="ViewBag.FkDocumentsId"></select>
            </div>
            <div class="form-group">
                <label asp-for="CreationDate" class="control-label"></label>
                <input asp-for="CreationDate" class="form-control" />
                <span asp-validation-for="CreationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastUpdateDate" class="control-label"></label>
                <input asp-for="LastUpdateDate" class="form-control" />
                <span asp-validation-for="LastUpdateDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

</body>
</html>
