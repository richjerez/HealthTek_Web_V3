@model HealthTek_Shared_Libraries.DocumentationProcess
<div class="row">
    <div class="col-lg-12">
        <form asp-action="Edit" method="post" enctype="multipart/form-data"
        onsubmit="return jQueryAjaxPost(this);">
            <input type="hidden" asp-for="FkEmployeesId" />
            <input type="hidden" asp-for="CreationDate" />
            <input type="hidden" asp-for="DocumentationProcessId" />
            <input type="hidden" asp-for="Role" />
            <input type="hidden" asp-for="FkRoleDocsCatalogId" />
            <input type="hidden" asp-for="FkDocuments.FkEmployeesId" />
            <input type="hidden" asp-for="FkDocuments.DocumentTitle" />
            <div class="text-center mb-4" id="drop_zone" ondrop="dropHandler(event);" ondragover="dragOverHandler(event);">
                <img src="/img/undraw_going_up_ttm5.svg" style="margin: auto;width: 300px;">
                <span style="font-size: 20px;display: block;"> Dropbox </span>
                <span style="display: block;"> Drop files here to upload! </span>
                <span style="display: block;"> Formats allowed: .xls,.xlsx, .doc, .docx, .pdf </span>
            </div>
            <hr />
            <div class="text-center">@Model.FkDocuments.DocumentTitle</div>
            <hr />
            <div class="custom-file">
                <input type="file" class="custom-file-input" multiple asp-for="FkDocuments.customFiles" onchange="displayFiles(this, true)"
                       accept=".csv, application/vnd.ms-excel, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,image/*,.pdf,.docx" />
                <span asp-validation-for="FkDocuments.customFiles" class="text-danger"></span>
                <label class="custom-file-label mb-0" for="customFile">Choose file</label>
            </div>
            <div class="form-group">
                <label asp-for="FkDocuments.DocumentStatus" class="control-label">Status</label>
                <select asp-for="FkDocuments.DocumentStatus" id="FkStatus" class="form-control" asp-items="ViewBag.Status"></select>
                <span asp-validation-for="FkDocuments.DocumentStatus" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FkDocuments.DocumentEffectiveDate" class="control-label"></label>
                        <input asp-for="FkDocuments.DocumentEffectiveDate" class="form-control" type="date" asp-format="{0:yyy-MM-dd}" />
                        <span asp-validation-for="FkDocuments.DocumentEffectiveDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FkDocuments.DocumentExpirationDate" class="control-label"></label>
                        <input asp-for="FkDocuments.DocumentExpirationDate" class="form-control" type="date" asp-format="{0:yyy-MM-dd}" />
                        <span asp-validation-for="FkDocuments.DocumentExpirationDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="FkDocuments.DocumentDescription" class="control-label"></label>
                <textarea asp-for="FkDocuments.DocumentDescription" class="form-control"></textarea>
                <span asp-validation-for="FkDocuments.DocumentDescription" class="text-danger"></span>
            </div>
            @{
                await Html.RenderPartialAsync("~/Views/Shared/_SubmitButton.cshtml", "Upload");
            }

        </form>
    </div>
</div>
