@model HealthTek_Shared_Libraries.EmployeesFacilities
<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Edit" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="FkEmployeesId" type="hidden"/>
                <input asp-for="EmployeesFacilitiesId" type="hidden"/>
                <input asp-for="CreationDate" type="hidden"/>
                <div class="form-group">
                    <label asp-for="FkFacilitiesId" class="control-label"></label>
                    <select asp-for="FkFacilitiesId" class="form-control" asp-items="ViewBag.FkFacilitiesId"></select>
                </div>
                <div class="form-group float-right mb-0">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>