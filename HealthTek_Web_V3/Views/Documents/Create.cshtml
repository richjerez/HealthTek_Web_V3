@model IEnumerable<HealthTek_Shared_Libraries.Documents>
@{
    ViewData["Title"] = "File Dropbox";
    ViewData["ActivePage"] = "FileDropbox";
    Documents documents = new Documents();
}

@section Styles{
    <!-- Custom styles for this page -->
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
}

<div class="">
    <div class="row mr-0 d-print-none">
        <div class="col-lg-12">
            <form asp-action="UploadDocuments" method="post" enctype="multipart/form-data" onsubmit="return jQueryAjaxPost(this);">
                <div class="text-center mt-5 mb-4" id="drop_zone" ondrop="dropHandler(event);" ondragover="dragOverHandler(event);">
                    <img src="/img/undraw_going_up_ttm5.svg" style="margin: auto;width: 300px;">
                    <span style="font-size: 20px;display: block;"> Dropbox </span>
                    <span style="display: block;"> Drop files here to upload! </span>
                    <span style="display: block;"> Formats allowed: .png, .jpg, .jpeg, .xls,.xlsx, .doc, .docx, .pdf </span>
                </div>
                <div class="d-flex mb-4">
                    <div class="custom-file mx-auto" style="width:300px;display: -webkit-box;">
                        <input type="file" class="custom-file-input" multiple asp-for="@documents.customFiles" onchange="displayFiles(this)"
                               accept=".csv, application/vnd.ms-excel, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,image/*,.pdf,.docx">
                        <label class="custom-file-label mb-0" for="customFile">Choose file</label>
                        <span asp-validation-for="@documents.customFiles" class="text-danger"></span>
                        <div class="ml-2">
                            <button class="btn btn-primary mt-0 ml-2" type="submit">
                                Upload
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div id="uploadedfilesPanel" class="col-lg-12">
        </div>
    </div>
    <div class="container">
        <hr class="d-print-none"/>
        <div class="row">
            <div class="col-lg-12">
                <!-- DataTales Example -->
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="m-0 font-weight-bold text-primary datatitle">
                                    Uploaded Files<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;"></i>
                                </h6>
                            </div>
                            <div class="col-md-6 text-right d-print-none">
                                <a asp-controller="Documents" asp-action="Index" class="d-none d-sm-inline-block btn btn-sm btn-success shadow-sm btn-icon-split" style="margin:0">
                                    <span class="icon text-white-50">
                                        <i class="fas fa-folder fa-sm text-white-50"></i>
                                    </span>
                                    <span class="text">Sort</span>
                                </a>
                                <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split " style="margin:0" onclick="window.print()">
                                    <span class="icon text-white-50">
                                        <i class="fas fa-print fa-sm text-white-50"></i>
                                    </span>
                                    <span class="text">Print</span>
                                </a>
                                <button id="ExportPdf" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split"
                                        onclick="ExportPDF('Documents')" style="margin:0">
                                    <span class="icon text-white-50">
                                        <i class="fas fa-file-pdf fa-sm text-white-50"></i>
                                    </span>
                                    <span class="text">PDF</span>
                                </button>
                                <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split " style="margin:0" onclick="ExportCSV('Documents',5)">
                                    <span class="icon text-white-50">
                                        <i class="fas fa-file-csv fa-sm text-white-50"></i>
                                    </span>
                                    <span class="text">CSV</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table" id="dataTable" width="100%" cellspacing="0">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th>
                                            Status
                                        </th>
                                        <th>
                                            Upload By
                                        </th>
                                        <th>
                                            Upload Date
                                        </th>
                                        <th data-orderable="false"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr onclick="displayInlineFile('@item.DocumentUrl')" ondblclick="LoadEdit('@item.DocumentsId', 'Documents')">
                                            <td>
                                                @Html.DisplayFor(modelItem => item.DocumentStatus)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.FkUploadedBy.EmployeeLabel)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.CreationDate)
                                            </td>
                                            <td class="text-right">
                                                <a asp-controller="Documents" asp-action="DownloadDocument" asp-route-id="@item.DocumentsId" class="btn btn-outline-primary d-print-none">
                                                    <span class="text">
                                                        <i class="fa fa-download"></i>
                                                    </span>
                                                </a>
                                                <a asp-controller="Documents" asp-action="Details" asp-route-id="@item.DocumentsId" asp-route-returnUrl="Create" class="btn btn-outline-info d-print-none">
                                                    <span class="text">
                                                        <i class="fa fa-server"></i>
                                                    </span>
                                                </a>
                                                <button onclick="DeleteElement(@item.DocumentsId, 'Documents','Create')" class="btn btn-outline-danger d-print-none">
                                                    <span class="text">
                                                        <i class="fa fa-trash"></i>
                                                    </span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <!-- Page level plugins -->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/js/demo/datatables-demo.js"></script>
    <!-- CSV Export scripts -->
    <script type="text/javascript" src="~/js/Exports/CSVExport.js"></script>

    <!-- Page level custom scripts starts -->
    <script src="~/js/demo/datatables-demo.js"></script>
    <script>
        $(document).ready(async function () {
            await loadScript("/js/afterLoad.js");
            // Do whatever you want to do after script is ready
        });
    </script>
    <script src="~/js/Cruds/Documents.js"></script>

}
