@model IEnumerable<HealthTek_Shared_Libraries.Documents>

@{
    ViewData["Title"] = "File Inbox";
    ViewData["ActivePage"] = "FileInbox";
}
@section Styles{
    <!-- Custom styles for this page -->
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
}

<div class="container">
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-4">
                    <h6 class="m-0 font-weight-bold text-primary datatitle">
                        @ViewData["Title"]<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;"></i>
                    </h6>
                </div>
                <div class="col-md-8 text-right">
                    <a asp-action="Create" asp-controller="Documents" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus fa-sm text-white-50"></i>
                        </span>
                        <span class="text">New Document</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="window.print()">
                        <span class="icon text-white-50">
                            <i class="fas fa-print fa-sm text-white-50"></i>
                        </span>
                        <span class="text">Print</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" asp-controller="Report" asp-action="Get" asp-route-ClassName="Documents" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-pdf fa-sm text-white-50"></i>
                        </span>
                        <span class="text">PDF</span>
                    </a>
                    <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="ExportCSV('Documents',6)">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-csv fa-sm text-white-50"></i>
                        </span>
                        <span class="text">CSV</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>
                                Uploaded On
                            </th>
                            <th>
                                Uploaded By
                            </th>
                            <th>
                                Type
                            </th>
                            <th data-orderable="false"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr ondblclick="LoadEdit('@item.DocumentsId', 'Documents')">
                                <td>
                                    @Html.DisplayFor(modelItem => item.CreationDate)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.FkUploadedBy.EmployeeLabel)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DocumentType)
                                </td>
                                <td class="text-right d-print-none">
                                    <a asp-controller="Documents" asp-action="DownloadDocument" asp-route-id="@item.DocumentsId"
                                    class="btn btn-outline-primary d-print-none">
                                        <span class="text">
                                            <i class="fa fa-download"></i>
                                        </span>
                                    </a>
                                    <a asp-controller="Documents" asp-action="Details" asp-route-id="@item.DocumentsId" asp-route-returnUrl="Index" class="btn btn-outline-info">
                                        <span class="text">
                                            <i class="fa fa-server"></i>
                                        </span>
                                    </a>
                                    <button onclick="DeleteElement(@item.DocumentsId, 'Documents')" class="btn btn-outline-danger">
                                        <span class="text">
                                            <i class="fa fa-trash"></i>
                                        </span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{

    <!-- Page level plugins -->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/js/demo/datatables-demo.js"></script>
    <!-- CSV Export scripts -->
    <script type="text/javascript" src="~/js/Exports/CSVExport.js"></script>

    <!-- Page level custom scripts starts -->
    <script src="~/js/demo/datatables-demo.js"></script>
    <script src="~/js/Cruds/Documents.js"></script>

    <script>
        $(document).ready(async function () {
            await loadScript("/js/afterLoad.js");
            // Do whatever you want to do after script is ready

        });

    </script>
}