@using System.ComponentModel
@using System.Reflection
@model HealthTek_Shared_Libraries.BaAssessments
@section Styles {
    <!-- Custom styles for this page -->
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
}
    <div class="card shadow mb-4">
        <div class="card-header pt-3 sticky-top pb-0">
            <div class="row">
                <div class="col-md-6">
                    <h4 class="m-0 font-weight-bold text-primary datatitle">
                        Behavior Analysis Assessment<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;"></i>
                    </h4>
                </div>
                <div class="col-md-6 text-right">
                    <small>Service Code:</small>
                    <p>@Model.FkAppointments.FkServiceCodes.CodeTitle</p>
                </div>
            </div>
            <hr class="mt-0" />
            <div class="row">
                <div class="col-md-3 border-right">
                    <small>Client:</small>
                    <a class="d-block" asp-controller="Clients" asp-action="Details" asp-route-id="@Model.FkAppointments.FkClientsId">@Model.FkAppointments.FkClients.FullName</a>
                    <span>@Model.FkAppointments.FkClients.ClientsFacilities.FirstOrDefault().ChartNumber</span>
                </div>
                <div class="col-md-3 border-right">
                    <small>From - To:</small>
                    <span class="d-block">@Model.FkAppointments.StartTime</span>
                    <span>@Model.FkAppointments.EndTime</span>
                </div>
                <div class="col-md-3 border-right">
                    <small>Location Start:</small>
                    <span class="d-block">@Model.FkAppointments.FkStartLocation.Address</span>
                    <span>@Model.FkAppointments.FkStartLocation.CityState,@Model.FkAppointments.FkStartLocation.Zipcode</span>
                </div>
                <div class="col-md-3">
                    <small>Location End:</small>
                    <span class="d-block">@Model.FkAppointments.FkEndLocation.Address</span>
                    <span>@Model.FkAppointments.FkEndLocation.CityState,@Model.FkAppointments.FkEndLocation.Zipcode</span>
                </div>
            </div>

        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <form asp-action="Edit" id="MyForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input asp-for="BaAssessmentsId" type="hidden" />
                        <input asp-for="FkAppointmentsId" type="hidden" />
                        <input asp-for="CreationDate" type="hidden" />
                        <div class="row">
                            <div class="col-lg-12">
                                <div id="TextAreaWrapper">
                                    <div class="form-group">
                                        <label asp-for="ReviewedDocuments" class="control-label">Documents Reviewed</label>
                                        <textarea asp-for="ReviewedDocuments" class="form-control"></textarea>
                                        <span asp-validation-for="ReviewedDocuments" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="BackgroundInformation" class="control-label"></label>
                                        <textarea asp-for="BackgroundInformation" class="form-control"></textarea>
                                        <span asp-validation-for="BackgroundInformation" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="RelevantFamilyHistory" class="control-label"></label>
                                        <textarea asp-for="RelevantFamilyHistory" class="form-control"></textarea>
                                        <span asp-validation-for="RelevantFamilyHistory" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="MajorAreasOfConcern" class="control-label"></label>
                                        <textarea asp-for="MajorAreasOfConcern" class="form-control"></textarea>
                                        <span asp-validation-for="MajorAreasOfConcern" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="PreviousTreatments" class="control-label"></label>
                                        <textarea asp-for="PreviousTreatments" class="form-control"></textarea>
                                        <span asp-validation-for="PreviousTreatments" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="CurrentTreatments" class="control-label"></label>
                                        <textarea asp-for="CurrentTreatments" class="form-control"></textarea>
                                        <span asp-validation-for="CurrentTreatments" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="EducationStatus" class="control-label"></label>
                                        <textarea asp-for="EducationStatus" class="form-control"></textarea>
                                        <span asp-validation-for="EducationStatus" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="PysicalMedicalStatus" class="control-label"></label>
                                        <textarea asp-for="PysicalMedicalStatus" class="form-control"></textarea>
                                        <span asp-validation-for="PysicalMedicalStatus" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="Medications" class="control-label"></label>
                                        <textarea asp-for="Medications" class="form-control"></textarea>
                                        <span asp-validation-for="Medications" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="AssessmentsConducted" class="control-label"></label>
                                        <textarea asp-for="AssessmentsConducted" class="form-control"></textarea>
                                        <span asp-validation-for="AssessmentsConducted" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="StrengthsWeaknesses" class="control-label"></label>
                                        <textarea asp-for="StrengthsWeaknesses" class="form-control"></textarea>
                                        <span asp-validation-for="StrengthsWeaknesses" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="IndirectResultsAndObservations"></label>
                                        <textarea asp-for="IndirectResultsAndObservations" class="form-control"></textarea>
                                        <span asp-validation-for="IndirectResultsAndObservations" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="GeneralizationMaintenance"></label>
                                        <textarea asp-for="GeneralizationMaintenance" class="form-control"></textarea>
                                        <span asp-validation-for="GeneralizationMaintenance" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="RiskAssessment"></label>
                                        <textarea asp-for="RiskAssessment" class="form-control"></textarea>
                                        <span asp-validation-for="RiskAssessment" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="GeneralizationMaintenance"></label>
                                        <textarea asp-for="MedicalNecessity" class="form-control"></textarea>
                                        <span asp-validation-for="MedicalNecessity" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="SummaryRecommendations"></label>
                                        <textarea asp-for="SummaryRecommendations" class="form-control"></textarea>
                                        <span asp-validation-for="SummaryRecommendations" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="ConsentToTreatment"></label>
                                        <textarea asp-for="ConsentToTreatment" class="form-control"></textarea>
                                        <span asp-validation-for="ConsentToTreatment" class="text-danger"></span>
                                    </div>
                                </div>
                                @* ABC Reports *@
                                <section id="AbcReports" class="content">
                                    <!-- ABC Reports - Card Header - Accordion -->
                                    <a href="#collapseABCReports" class="d-block card-header py-3 collapsed" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="collapseABCReports">
                                        <h6 class="m-0 font-weight-bold text-primary">ABC Reports</h6>
                                    </a>
                                    <!-- ABC Reports Content -->
                                    <div class="collapse" id="collapseABCReports">
                                        <div class="card-body shadow mb-4 ">
                                            <div class="text-right">
                                                <button type="button" onclick="AddEditElements(0, 'AbcReports', false, @Model.BaAssessmentsId)"
                                                    class="d-none d-sm-inline-block btn btn-xs btn-primary shadow-sm btn-icon-split d-print-none">
                                                    <span class="icon text-white-50">
                                                        <i class="fas fa-plus fa-sm text-white-50"></i>
                                                    </span>
                                                    <span class="text align-self-md-center">New A.B.C.</span>
                                                </button>
                                            </div>
                                            <div class="row">
                                                @foreach (var report in Model.AbcReports)
                                            {
                                                <div class="col-lg-6">
                                                    <div style="border-radius: 5px;" class="status status-purple pt-2 pl-3 pr-3">
                                                        <button type="button" onclick="DeleteElement(@report.AbcReportsId, 'AbcReports')" class="d-none d-sm-inline-block btn btn-xs btn-danger shadow-sm btn-icon-split d-print-none float-right ml-2">
                                                            <span class="icon text-white-50">
                                                                <i class="fas fa-trash fa-sm text-white-50"></i>
                                                            </span>
                                                        </button><button type="button" onclick="AddEditElements(@report.AbcReportsId, 'AbcReports', false, @Model.BaAssessmentsId)" class="d-none d-sm-inline-block btn btn-xs btn-primary shadow-sm btn-icon-split d-print-none float-right">
                                                            <span class="icon text-white-50">
                                                                <i class="fas fa-edit fa-sm text-white-50"></i>
                                                            </span>
                                                        </button>
                                                        @{
                                                            await Html.RenderPartialAsync("~/Views/AbcReports/Details.cshtml", report);
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                    </div>
                                </div>

                            </section>
                            @* Maladaptives *@
                            <!-- Maladaptives - Card Header - Accordion -->
                            <a href="#collapseMaladaptives" class="d-block card-header py-3 collapsed" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="collapseMaladaptives">
                                <h6 class="m-0 font-weight-bold text-primary">Maladaptives</h6>
                            </a>
                            <!-- Maladaptives Content -->
                            <div class="collapse" id="collapseMaladaptives">
                                <div class="card-body shadow mb-4 ">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="text-right">
                                                <button type="button" onclick="AddEditElements(0, 'Maladaptives', false, @Model.BaAssessmentsId)"
                                                        class="d-none d-sm-inline-block btn btn-xs btn-primary shadow-sm btn-icon-split d-print-none float-right mr-3 mt-0">
                                                    <span class="icon text-white-50">
                                                        <i class="fas fa-plus fa-sm text-white-50"></i>
                                                    </span>
                                                    <span class="text align-self-md-center">New Maladaptives</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    @foreach (var item in Model.Maladaptives)
                                    {
                                        await Html.RenderPartialAsync("~/Views/Maladaptives/Details.cshtml", item);

                                        <!-- Replacement -->
                                        @if (item.FkReplacements != null)
                                        {
                                            var replacement = item.FkReplacements;
                                            await Html.RenderPartialAsync("~/Views/Replacements/Details.cshtml", replacement);
                                        }
                                        else
                                        {
                                            <div class="card shadow">
                                                <div class="card-header py-3 bg-danger">
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <h6 class="m-0 font-weight-bold text-white datatitle">
                                                                Replacement<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;"></i>
                                                            </h6>
                                                        </div>
                                                        <div class="col-md-6 text-right d-print-none">
                                                            <a onclick="AddEditElements(0, 'Replacements', false, @item.MaladaptivesId)" class="d-none d-sm-inline-block btn btn-xs btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0">
                                                                <span class="icon text-white-50">
                                                                    <i class="fas fa-plus fa-sm text-white-50"></i>
                                                                </span>
                                                                <span class="text">New Replacement</span>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }

                                </div>
                            </div>

                            @* Interventions *@
                            <!-- Interventions - Card Header - Accordion -->
                            <a href="#collapseInterventions" class="d-block card-header py-3 collapsed" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="collapseInterventions">
                                <h6 class="m-0 font-weight-bold text-primary">Interventions</h6>
                            </a>
                            <!-- Interventions Content -->
                            <div class="collapse" id="collapseInterventions">
                                <div class="card-body shadow mb-4 ">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="text-right">
                                                <button type="button" onclick="AddEditElements(0, 'BaAssessmentsInterventions', false, @Model.BaAssessmentsId)"
                                                        class="d-none d-sm-inline-block btn btn-xs btn-primary shadow-sm btn-icon-split d-print-none float-right">
                                                    <span class="icon text-white-50">
                                                        <i class="fas fa-plus fa-sm text-white-50"></i>
                                                    </span>
                                                    <span class="text align-self-md-center">New Interventions</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        @foreach (var report in Model.BaAssessmentsInterventions)
                                        {
                                            await Html.RenderPartialAsync("~/Views/BaAssessmentsInterventions/Details.cshtml", report);
                                        }
                                    </div>
                                </div>
                            </div>

                            @* Preference *@
                            <!-- Preference - Card Header - Accordion -->
                            <a href="#collapsePreferences" class="d-block card-header py-3 collapsed" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="collapsePreferences">
                                <h6 class="m-0 font-weight-bold text-primary">Preferences</h6>
                            </a>
                            <!-- Preference Content -->
                            <div class="collapse" id="collapsePreferences">
                                <div class="card-body shadow mb-4 ">
                                    <div class="text-right d-print-none">
                                        <a onclick="AddEditElements(0, 'Preferences', false, @Model.FkAppointments.FkClients.ClientsId)" class="d-none d-sm-inline-block btn btn-xs btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0">
                                            <span class="icon text-white-50">
                                                <i class="fas fa-plus fa-sm text-white-50"></i>
                                            </span>
                                            <span class="text">New Preference</span>
                                        </a>
                                    </div>
                                    @if (Model.FkAppointments.FkClients.Preferences != null)
                                    {
                                        var report = Model.FkAppointments.FkClients.Preferences;
                                        await Html.RenderPartialAsync("~/Views/Preferences/Details.cshtml", report);
                                    }
                                    else
                                    {
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <button type="button" onclick="AddEditElements(0, 'Preferences', false, @Model.FkAppointments.FkClients.ClientsId)"
                                                    class="d-none d-sm-inline-block btn btn-xs btn-primary shadow-sm btn-icon-split d-print-none float-right">
                                                    <span class="icon text-white-50">
                                                        <i class="fas fa-plus fa-sm text-white-50"></i>
                                                    </span>
                                                    <span class="text align-self-md-center">New Preference</span>
                                                </button>
                                            </div>
                                        </div>

                                    }
                                </div>
                            </div>
                            @* RBT Rationale Accordion Header *@
                            <a href="#rbtRationaleContent" class="d-block card-header py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="rbtRationaleContent">
                                <h6 class="m-0 font-weight-bold text-primary">RBT Rationale</h6>
                            </a>
                            @* RBT Rationale Accordion Content *@
                            <div id="rbtRationaleContent" class="collapse show">
                                <div class="card-body mb-4 shadow">
                                    <p>
                                        Specific duties and responsibilities: Collect data on target behaviors identified for reduction/acquisition/replacement, implement the behavior program and train the caregivers on data collection and implementation of the procedures outline within the plan.
                                    </p>
                                    <p>
                                        Work Schedule and Schedule of activities: Behavior assistant will work with consumer <input type="text" class="form-control" id="dateRange" name="dateRange" value="Monday - Friday" style="width: 160px;display: initial;" /> from <input asp-for="EmployeeScheduledStartTime" type="time" asp-format="{0:HH:mm:ss}" style="width: 160px;display: initial;" class="form-control" /> to <input type="time" asp-for="EmployeeScheduledEndTime" asp-format="{0:HH:mm:ss}" style="width: 160px;display: initial;" class="form-control" /> and during that time all programs will be implemented. This schedule is subject to change as per caregiver request making sure that amount of hours of services needed to implement the plan does not change.
                                    </p>
                                    <p>
                                        Ongoing Assessment Responsibilities: RBT will be responsible for collection of ongoing ABC data that will be used to assess the continued efficacy of the program/ interventions. Behavior Assistant will also record data sheets provided and attached to the program.
                                    </p>
                                    <p>
                                        Training Procedures for Caregivers: Following competency-based training by the behavior analyst of the caregivers with regards to the interventions outline within the behavior program, the behavior assistant will complete competency checks of the caregivers’ ability to collect data, implement replacement programs and follow through on the interventions. Competency checks will include demonstration/modeling of  procedures, observation of  caregiver implementing replacement/acquisition programs, as well as corrective feedback when warranted
                                    </p>
                                </div>
                            </div>
                            @* Ba Crisis Plan *@
                            <div class="card shadow p-3 mt-4">
                                @if (Model.BaCrisisPlan.Count != 0)
                                {
                                    foreach (var plans in Model.BaCrisisPlan)
                                    {
                                        await Html.RenderPartialAsync("~/Views/BaCrisisPlans/Details.cshtml", plans);
                                    }
                                }
                                else
                                {
                                    <button type="button" onclick="AddEditElements(0, 'BaCrisisPlans', false, @Model.BaAssessmentsId)"
                                        class="d-none d-sm-inline-block btn btn-xs btn-primary shadow-sm btn-icon-split d-print-none float-right">
                                        <span class="icon text-white-50">
                                            <i class="fas fa-plus fa-sm text-white-50"></i>
                                        </span>
                                        <span class="text align-self-md-center">New Crisis Plan</span>
                                    </button>
                                    <h4>Crisis Plan</h4>
                                }
                            </div>
                            @* Communication with other providers *@
                            <div class="shadow p-3 mt-4 mb-4 pb-5">
                                <h4>Communication with other providers</h4>
                                <hr />
                                <div class="form-group">
                                    <label>Have you communicated with the recipient's prescriber of psychotropic drugs?</label>
                                    <select asp-for="OtherProviderDrugPrescriber" asp-items="ViewBag.Communication" class="form-control"></select>
                                    <span asp-validation-for="OtherProviderDrugPrescriber" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label>Have you communicated with the recipient's PCP?</label>
                                    <select asp-for="OtherProviderPcp" asp-items="ViewBag.Communication" class="form-control"></select>
                                    <span asp-validation-for="OtherProviderPcp" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label>Have you documented the communication or recipient declination?</label>
                                    <select asp-for="OtherProviderDocumentedComm" asp-items="ViewBag.Communication" class="form-control"></select>
                                    <span asp-validation-for="OtherProviderDocumentedComm" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label>
                                        Have you been in communication with other Behavior Health (BH) providers for this recipient?
                                    </label>
                                    <select asp-for="OtherProviderBhComm" asp-items="ViewBag.Communication" class="form-control"></select>
                                    <span asp-validation-for="OtherProviderBhComm" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label>If yes, please indicate the type of BH provider</label>
                                    <input asp-for="OtherProviderBhComm" class="form-control" />
                                    <span asp-validation-for="OtherProviderBhCommType" class="text-danger"></span>
                                </div>
                            </div>
                            @* Authorizations *@
                            <div class="">
                                <div class="card shadow mb-4">
                                    <div class="card-header py-3">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <h6 class="m-0 font-weight-bold text-primary datatitle">
                                                    Authorizations<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;"></i>
                                                </h6>
                                            </div>
                                            <div class="col-md-6 text-right d-print-none">
                                                <a onclick="AddEditElements(0, 'Authorizations', false, @Model.FkAppointments.FkClientsId, @Model.BaAssessmentsId)" class="d-none d-sm-inline-block btn btn-xs btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0">
                                                    <span class="icon text-white-50">
                                                        <i class="fas fa-plus fa-sm text-white-50"></i>
                                                    </span>
                                                    <span class="text">New Authorization</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="timeline-content " id="activity">
                                            <div class="timeline-content" style="float: right;margin-right: 5px;">
                                                <div class="status-legend status-pink" style="border-radius: 5px;overflow: hidden;"></div>
                                                <small style="display: inline-block;margin-left: 5px;">Units &lt; 20%</small>
                                            </div><div class="timeline-content " style="float: right;margin-right: 5px;">
                                                <div class="status-legend status-orange" style="border-radius: 5px;overflow: hidden;"></div>
                                                <small style="margin-left: 5px;">Units Left</small>
                                            </div>
                                            <div class="timeline-content " style="margin-right: 5px;float: right;">
                                                <div class="status-legend status-blue" style="border-radius: 5px;"></div>
                                                <small style="margin-left: 5px;">Units Used</small>
                                            </div><div class="timeline-content " style="margin-right: 5px;float: right;">
                                                <div class="status-legend status-Closed"></div>
                                                <small style="margin-left: 5px;">Total Units</small>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table" id="dataTable" width="100%" cellspacing="0">
                                                <thead class="bg-primary text-white">
                                                    <tr>
                                                        <th class="text-center">
                                                            Status
                                                        </th>
                                                        <th>
                                                            Code
                                                        </th>
                                                        <th>
                                                            PA Number
                                                        </th>
                                                        <th class="text-center">
                                                            Units
                                                        </th>
                                                        <th>
                                                            Effective Date
                                                        </th>
                                                        <th>
                                                            Expiration Date
                                                        </th>
                                                        <th data-orderable="false"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.Authorizations)
                                                    {

                                                        <tr ondblclick="AddEditElements(@item.AuthorizationsId, 'Authorizations')">
                                                            <td class="text-center" style="vertical-align: middle;">
                                                                <a class="status-@item.AuthorizationStatus">
                                                                    @Html.DisplayFor(modelItem => item.AuthorizationStatus)
                                                                </a>
                                                            </td>
                                                            <td style="vertical-align: middle;">
                                                                @Html.DisplayFor(modelItem => item.FkServiceCodes.FullCode)
                                                            </td>
                                                            <td style="vertical-align: middle;">
                                                                @Html.DisplayFor(modelItem => item.AuthorizationNumber)
                                                            </td>
                                                            <td style="vertical-align: middle;">
                                                                @{
                                                                    var clasSstyle = "custom-badge status-orange";
                                                                    var used = "0";
                                                                    if (item.UnitsUsed != null) { used = item.UnitsUsed.ToString(); }
                                                                    var unitsleft = item.UnitAmount.ToString();
                                                                    if (item.UnitsLeft != null) { unitsleft = item.UnitsLeft.ToString(); }
                                                                    if (item.UnitsLeft < (item.UnitAmount * 20 / 100))
                                                                    {

                                                                        clasSstyle = "custom-badge status-pink";
                                                                    }
                                                                }
                                                                <div style="text-align:center">
                                                                    <span class="custom-badge status-purple">@item.UnitAmount</span>
                                                                    <span class="custom-badge status-blue">@used</span>
                                                                    <span class="@clasSstyle">@unitsleft</span>
                                                                </div>
                                                            </td>
                                                            <td style="vertical-align: middle;">
                                                                @Html.DisplayFor(modelItem => item.EffectiveDate)
                                                            </td>
                                                            <td style="vertical-align: middle;">
                                                                @Html.DisplayFor(modelItem => item.ExpirationDate)
                                                            </td>
                                                            <td class="text-right d-print-none" style="vertical-align: middle;">
                                                                <button type="button" onclick="AddEditElements(@item.AuthorizationsId, 'Authorizations', true, @Model.BaAssessmentsId)" href="#" class="btn btn-outline-info ">
                                                                    <span class="text">
                                                                        <i class="fa fa-server"></i>
                                                                    </span>
                                                                </button>
                                                                <button type="button" onclick="DeleteElement(@item.AuthorizationsId, 'Authorizations')" href="#" class="btn btn-outline-danger ">
                                                                    <span class="text">
                                                                        <i class="fa fa-trash"></i>
                                                                    </span>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @* Disclaimer *@
                            <div class="container"><div class="alert alert-warning text-center"><strong>Disclaimer:</strong> Applying the E-Signature will save the form and route the user to the Quality Asurrance page.</div></div>
                            @* Signatures *@
                            <div class="d-flex justify-content-center">
                                <div style="padding: 1rem;">
                                    <span style="vertical-align: -webkit-baseline-middle;">
                                        @Model.FkAppointments.FkEmployees.EmployeesRoleNames.FirstOrDefault().FkRoleNames.RoleName:
                                        @Model.FkAppointments.FkEmployees.FullName
                                    </span>
                                </div>
                                <div style="border: dashed;padding: 1rem;">
                                    <input type="submit" value="Apply E-Sign" class="btn btn-outline-primary mb-0 mt-0">
                                </div>
                                <div style="padding: 1rem;">
                                    <span style="vertical-align: -webkit-baseline-middle;">
                                        @DateTime.Now.ToShortDateString()
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
