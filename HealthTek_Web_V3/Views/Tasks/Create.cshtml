@model HealthTek_Shared_Libraries.Tasks

<div class="card shadow p-4">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Create" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="DueDate" class="control-label"></label>
                            <input asp-for="DueDate" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="TaskType" class="control-label"></label>
                            <select asp-for="TaskType" class="ModalSelect" asp-items="ViewBag.Types"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="FkAssignedToId" class="control-label"></label>
                            <select asp-for="FkAssignedToId" class="ModalSelect" data-live-search="true" asp-items="ViewBag.FkAssignedToId"></select>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="TaskStatus" class="control-label"></label>
                            <select asp-for="TaskStatus" class="ModalSelect" asp-items="ViewBag.Status"></select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="TaskSubject" class="control-label"></label>
                    <input asp-for="TaskSubject" class="form-control" />
                    <span asp-validation-for="TaskSubject" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="TaskDescription" class="control-label"></label>
                    <input asp-for="TaskDescription" class="form-control" />
                    <span asp-validation-for="TaskDescription" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="TaskNote" class="control-label"></label>
                    <textarea asp-for="TaskNote" class="form-control"></textarea>
                    <span asp-validation-for="TaskNote" class="text-danger"></span>
                </div>
                <div class="form-group float-right mb-0">
                    <input type="submit" value="Create Task" class="btn btn-outline-primary" />
                </div>
            </form>
        </div>
    </div>
</div>
