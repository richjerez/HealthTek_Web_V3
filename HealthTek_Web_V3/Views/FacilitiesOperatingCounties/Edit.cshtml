@model HealthTek_Shared_Libraries.FacilitiesOperatingCounties
<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Edit" onsubmit="return jQueryAjaxPost(this);">
                <input type="hidden" asp-for="FkFacilitiesId"/>
                <input type="hidden" asp-for="FacilitiesOperatingCountiesId"/>
                <input type="hidden" asp-for="CreationDate"/>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="FkOperatingCountiesId" class="control-label"></label>
                    <select asp-for="FkOperatingCountiesId" class="form-control" asp-items="ViewBag.FkOperatingCountiesId" data-live-search="true"></select>
                </div>
                <div class="form-group text-right">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>