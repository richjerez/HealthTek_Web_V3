@model HealthTek_Shared_Libraries.SupportTickets

<div class="text-center">
    <i class="fas fa-exclamation-triangle fa-5x text-warning pb-2"></i>
    <h5>
        Warning: This will permanently delete this support ticket. Are you sure you want to delete this ticket?
    </h5>
    <hr />
    <form asp-action="Delete" class="text-right row" asp-route-id="@Model.SupportTicketsId">
        <div class="col-md-12 mr-4">
            <input type="button" value="Cancel" class="btn btn-secondary ml-2" data-dismiss="modal">
            <input type="submit" value="Delete" class="btn btn-danger">
        </div>
    </form>
</div>
