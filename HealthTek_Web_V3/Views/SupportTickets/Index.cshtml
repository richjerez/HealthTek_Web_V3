@model IEnumerable<HealthTek_Shared_Libraries.SupportTickets>

@{
    ViewData["Title"] = "Support Tickets";
    ViewData["SingularTitle"] = "Ticket";
}

@section Styles{
    <!-- Custom styles for this page -->
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
}

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-4">
                    <h6 class="m-0 font-weight-bold text-primary datatitle">
                        @ViewData["Title"]<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;"></i>
                    </h6>
                </div>
                <div class="col-md-8 text-right">
                    <button onclick="AddEditElements(0, 'SupportTickets')" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus fa-sm text-white-50"></i>
                        </span>
                        <span class="text">New @ViewData["SingularTitle"]</span>
                    </button>
                    @*                <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="window.print()">
                <span class="icon text-white-50">
                <i class="fas fa-print fa-sm text-white-50"></i>
                </span>
                <span class="text">Print</span>
                </a>
                <button id="ExportPdf" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none"
                style="margin:0" asp-controller="Report" asp-action="Get" asp-route-ClassName="Tasks" asp-route-EmployeeId="@ViewBag.User">
                <span class="icon text-white-50">
                <i class="fas fa-file-pdf fa-sm text-white-50"></i>
                </span>
                <span class="text">PDF</span>
                </button>
                <button type="button" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none"
                style="margin:0" asp-controller="Tasks" asp-action="ExportTasksData">
                <span class="icon text-white-50">
                <i class="fas fa-file-csv fa-sm text-white-50"></i>
                </span>
                <span class="text">CSV</span>
                </button>
                *@
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>
                                Ticket Id
                            </th>
                            <th>
                                Date
                            </th>
                            <th>
                                Created By
                            </th>
                            <th class="text-center">
                                Description
                            </th>
                            <th data-orderable="false" class="d-print-none"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                    {
                        <tr ondblclick="AddEditElements(@item.SupportTicketsId,'SupportTickets')">
                            <td>
                                @Html.DisplayFor(modelItem => item.TicketNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CreationDate)
                            </td>
                            <td>
                                <a asp-controller="Employees" asp-action="Details" asp-route-id="@item.FkAssignedBy.EmployeesId">
                                    @Html.DisplayFor(modelItem => item.FkAssignedBy.EmployeeLabel)
                                </a>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                <button onclick="DeleteElement('@item.SupportTicketsId', 'SupportTickets')" class="btn btn-outline-danger d-print-none">
                                    <span class="text">
                                        <i class="fa fa-trash"></i>
                                    </span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts{
    <!-- Page level plugins -->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/js/demo/datatables-demo.js"></script>
}
