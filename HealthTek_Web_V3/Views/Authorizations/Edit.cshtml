@model HealthTek_Shared_Libraries.Authorizations

<div class="card shadow p-3">
    <form asp-action="Edit" id="myForm" onsubmit="return jQueryAjaxPost(this);">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="width: 100%;"></div>
        <input asp-for="AuthorizationsId" type="hidden" />
        <input asp-for="FkBaAssessmentsId" type="hidden" />
        <input asp-for="CreationDate" type="hidden" />
        <input asp-for="LastUpdateDate" type="hidden" />
        <div class="row">
            <div class="col-xl-6 border-right">
                <div class="form-group">
                    <label asp-for="FkClientsId" class="select-label"></label>
                    <select asp-for="FkClientsId" class="ModalSelect" data-live-search="true" asp-items="ViewBag.FkClientsId"></select>
                </div>
                <div class="form-group">
                    <label asp-for="AuthorizationNumber" class="control-label"></label>
                    <input asp-for="AuthorizationNumber" class="form-control" />
                    <span asp-validation-for="AuthorizationNumber" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="UnitAmount" class="control-label"></label>
                            <input asp-for="UnitAmount" class="form-control" onchange="calcUnits()" type="number" min="0" step="1" />
                            <span asp-validation-for="UnitAmount" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="WeeklyHours" class="control-label"></label>
                            <input asp-for="WeeklyHours" class="form-control" onchange="calcUnits()" type="number" min="0" step="1" />
                            <span asp-validation-for="WeeklyHours" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="WeeklyUnits" class="control-label"></label>
                            <input asp-for="WeeklyUnits" class="form-control" type="number" disabled min="0" step="1" />
                            <span asp-validation-for="WeeklyUnits" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="form-group">
                    <label asp-for="FkFacilitiesId" class="select-label"></label>
                    <select asp-for="FkFacilitiesId" class="ModalSelect" asp-items="ViewBag.FkFacilitiesId"></select>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EffectiveDate" class="control-label"></label>
                            <input asp-for="EffectiveDate" class="form-control" />
                            <span asp-validation-for="EffectiveDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ExpirationDate" class="control-label"></label>
                            <input asp-for="ExpirationDate" class="form-control" />
                            <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="FkServiceCodesId" class="select-label"></label>
                            <select asp-for="FkServiceCodesId" class="ModalSelect" asp-items="ViewBag.FkServiceCodesId"></select>
                        </div>
                    </div><div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="AuthorizationStatus" class="select-label"></label>
                            <select asp-for="AuthorizationStatus" class="ModalSelect" asp-items="ViewBag.Status"></select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group mb-0">
            <label>
                <input type="checkbox" id="initial" name="initial" value="false"><small class="ml-2" style="vertical-align: text-top;" onchange="this.value=this.checked">Is this an initial Authorization?</small>
            </label>
        </div>
        <div class="form-group">
            <label asp-for="Notes" class="control-label">Authorization Note</label>
            <textarea asp-for="Notes" class="form-control"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
        <hr />
        <div class="form-group">
            <label asp-for="DenialReason" class="control-label"></label>
            <textarea asp-for="DenialReason" class="form-control"></textarea>
            <span asp-validation-for="DenialReason" class="text-danger"></span>
        </div>

        @{
            await Html.RenderPartialAsync("~/Views/Shared/_SubmitButton.cshtml", "Save");
        }
    </form>
</div>

