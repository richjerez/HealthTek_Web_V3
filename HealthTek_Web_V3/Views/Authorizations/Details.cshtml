@model HealthTek_Shared_Libraries.Authorizations
<div class="card shadow p-4">
    <div class="row">
        <div class="col-lg-4">
            <h6 class="mb-0"><a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.FkClientsId">@Model.FkClients.FullName</a></h6>
            <small>
                @Model.FkClients.ClientsFacilities.FirstOrDefault().ChartNumber
            </small>            <small class="d-block"><strong>Facility</strong></small>
                                <a asp-controller="Facilities" asp-action="Details" asp-route-id="@Model.FkFacilitiesId">@Model.FkFacilities.FacilityName</a>
            <small class="d-block"><strong>PA #</strong></small>
            @Model.AuthorizationNumber
        </div>
        <div class="col-lg-1"><div class="divider"></div></div>
        <div class="col-lg-7">
            <form asp-controller="Authorizations" asp-action="CreateNote">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input name="FkAuthorizationsId" id="FkAuthorizationsId" type="hidden" value="@Model.AuthorizationsId" />
                <div class="col-xl-12">
                    <div class="form-group">
                        <label asp-for="Notes" class="control-label">New Note</label>
                        <textarea asp-for="Notes" class="form-control" data-val-required="The Notes field is required."
                                  data-val-maxlength-max="5000"
                                  data-val-maxlength="The field Notes must be a string or array type with a maximum length of '5000'."
                                  data-val="true"></textarea>
                    </div>
                </div>
                <div class="col-lg-12 form-group mb-0">
                    <input type="submit" value="Create New Note" class="btn btn-primary float-right" />
                </div>
            </form>
        </div>
    </div>
    <hr>
    <div class="row">
        <div class="col-lg-12">
            <small class="d-block"><strong>Auth Notes</strong></small>
            @foreach (var note in Model.AuthorizationNotes)
            {
                <small class="d-block"><strong>@note.EmployeeName</strong></small>
                <small class="d-block">@note.NoteDate</small>
                @note.Notes
                <hr />
            }
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var search = document.getElementsByClassName("modal-dialog")[0];
        search.setAttribute('class', 'modal-dialog modal-lg');
    </script>
}