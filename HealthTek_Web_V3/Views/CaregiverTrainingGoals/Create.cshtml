@model HealthTek_Shared_Libraries.CaregiverTrainingGoals

<div class="card shadow p-3">
<div class="row">
        <div class="col-md-12">
        <form asp-action="Create" onsubmit="return jQueryAjaxPost(this);">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="FkMaladaptivesId"/>
                <input type="hidden" asp-for="FkReplacementsId"/>
                <input type="hidden" asp-for="FkPreferencesId"/>
                <input type="hidden" asp-for="FkBaAssessmentsInterventionsId"/>
            <div class="form-group">
                <label asp-for="Baseline" class="control-label"></label>
                <input asp-for="Baseline" class="form-control" />
                <span asp-validation-for="Baseline" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BaselineCollectedStart" class="control-label"></label>
                    <input asp-for="BaselineCollectedStart" class="form-control" asp-format="{0:yyy-MM-dd}" />
                <span asp-validation-for="BaselineCollectedStart" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BaselineCollectedEnd" class="control-label"></label>
                    <input asp-for="BaselineCollectedEnd" class="form-control"  asp-format="{0:yyy-MM-dd}"/>
                <span asp-validation-for="BaselineCollectedEnd" class="text-danger"></span>
            </div>
        @{await Html.RenderPartialAsync("~/Views/Shared/_SubmitButton.cshtml","Create");}
        </form>
    </div>
</div>
</div>
