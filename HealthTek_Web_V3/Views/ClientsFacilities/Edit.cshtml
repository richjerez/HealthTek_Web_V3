@model HealthTek_Shared_Libraries.ClientsFacilities
<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Edit" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="ClientsFacilitiesId" type="hidden" />
                <input asp-for="FkClientsId" type="hidden" />
                <input asp-for="CreationDate" type="hidden" />
                <div class="form-group">
                    <label asp-for="FkFacilitiesId" class="control-label"></label>
                    <select asp-for="FkFacilitiesId" class="form-control" asp-items="ViewBag.FkFacilitiesId"></select>
                </div>
                <div class="form-group">
                    <label asp-for="ClientLabel" class="control-label"></label>
                    <input asp-for="ClientLabel" class="form-control" />
                    <span asp-validation-for="ClientLabel" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ChartNumber" class="control-label"></label>
                    <input asp-for="ChartNumber" class="form-control" />
                    <span asp-validation-for="ChartNumber" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary float-right" />
                </div>
            </form>
        </div>
    </div>
</div>
