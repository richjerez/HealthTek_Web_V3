@model IEnumerable<HealthTek_Shared_Libraries.CaregiverCompetencies>

@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@{
    var user = UserManager.GetUserAsync(User).Result;
}
<div class="table-responsive">
    <table class="table" id="dataTable2" width="100%" cellspacing="0">
        <thead class="bg-primary text-white">
            <tr>
                <th>CCC Info</th>
                @foreach (var item in Model.Where(b => b.CaregiverCompChecks != null).ToList())
                {
                    @foreach (var check in item.CaregiverCompChecks)
                    {
                        <th>
                            @check.FkCaregiverComptChecksCatalog.TrainingItem
                        </th>
                    }
                }
            </tr>
        </thead>
        <tbody id="TableBody">
            @foreach (var item in Model.Where(b => b.CaregiverCompChecks != null).ToList())
            {
                var client = item.BaProgressNotes.FkAppointments.FkEmployees;
                <tr>
                    <td>
                        <small>Employee</small>
                        <a class="d-block" asp-controller="Employees" asp-action="Details" asp-route-id="@client.EmployeesId">@client.FullName</a>
                        <small>Service</small>
                        <span class="d-block">@item.BaProgressNotes.FkAppointments.FkServiceCodes.CodeTitle</span>
                        <small>Appointment</small>
                        <span class="d-block">@item.BaProgressNotes.FkAppointments.StartTime</span>
                    </td>
                    @foreach (var check in item.CaregiverCompChecks)
                    {
                        <td>
                            <small>Baseline</small>
                            <span class="d-block">@check.CompetencyBaseline</span>
                            <small>Level</small>
                            <span class="d-block">@check.CompetencyLevel%</span>
                            <small>Summary</small>
                            <span class="d-block">@check.CompetencySummary</span>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>