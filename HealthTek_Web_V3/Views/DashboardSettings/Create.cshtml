@model HealthTek_Shared_Libraries.Dashboards

<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Create" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="DashboardName" class="control-label"></label>
                    <input asp-for="DashboardName" class="form-control" />
                    <span asp-validation-for="DashboardName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input asp-for="@Model.MainView" />
                    <label asp-for="MainView" class="control-label"></label>
                    <span asp-validation-for="MainView" class="text-danger"></span>
                </div>
        @{await Html.RenderPartialAsync("~/Views/Shared/_SubmitButton.cshtml","Create");}
            </form>
        </div>
    </div>
</div>
