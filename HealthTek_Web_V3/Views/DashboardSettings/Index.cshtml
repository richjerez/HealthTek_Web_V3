@model IEnumerable<HealthTek_Shared_Libraries.Dashboards>

@section Styles{
    <!-- Custom styles for this page -->
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
}

<div class="container">
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="m-0 font-weight-bold text-primary datatitle">
                        User Dashboards<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;"></i>
                    </h6>
                </div>
                <div class="col-md-6 text-right d-print-none">
                    <a onclick="AddEditElements(0,'DashboardSettings')" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus fa-sm text-white-50"></i>
                        </span>
                        <span class="text">New Dashboard</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split " style="margin:0" onclick="window.print()">
                        <span class="icon text-white-50">
                            <i class="fas fa-print fa-sm text-white-50"></i>
                        </span>
                        <span class="text">Print</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split" style="margin:0" 
                    asp-controller="Report" asp-action="Get" asp-route-ClassName="Dashboards" asp-route-EmployeeId="GETUSERFROMCONTROLLER">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-pdf fa-sm text-white-50"></i>
                        </span>
                        <span class="text">PDF</span>
                    </a>
                    <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split " style="margin:0" onclick="ExportCSV('DashboardSettings',2)">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-csv fa-sm text-white-50"></i>
                        </span>
                        <span class="text">CSV</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>
                                Name
                            </th>
                            <th>
                                Widgets
                            </th>
                            <th data-orderable="false"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr ondblclick="AddEditElements(@item.DashboardId, 'DashboardSettings')">
                                <td>
                                    @Html.DisplayFor(modelItem => item.DashboardName)
                                </td>
                                <td>
                                    @{
                                        var widgetcount = item.FkDashboardWidgets.Count();
                                        if (widgetcount != 0)
                                        {
                                            foreach (var widgetTop in item.FkDashboardWidgets.OrderBy(m => m.HierarchySlot))
                                            {
                                                <div id="@widgetTop.FkWidgetId" name="@widgetTop.HierarchySlot">
                                                    <div class="clearfix" >
                                                        <button class="btn float-left">@widgetTop.FkWidget.WidgetName</button>
                                                        <button class="btn btn-outline-danger float-right d-print-none" onclick="DeleteElement(@widgetTop.DashboardWidgetId,'DashboardWidgets')"><i class="fas fa-trash fa-xs"></i></button>
                                                    </div>
                                                    <hr class="mt-0">
                                                </div>
                                            }
                                        }
                                    }
                                </td>
                                <td class="text-right d-print-none">
                                    <button onclick="DeleteElement(@item.DashboardId, 'DashboardSettings')" class="btn btn-outline-danger d-print-none">
                                        <span class="text">
                                            <i class="fa fa-trash"></i>
                                        </span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{

    <!-- Page level plugins -->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/js/demo/datatables-demo.js"></script>
    <!-- CSV Export scripts -->
    <script type="text/javascript" src="~/js/Exports/CSVExport.js"></script>

    <!-- Page level custom scripts starts -->
    <script src="~/js/demo/datatables-demo.js"></script>

    <script>
        $(document).ready(async function () {
            await loadScript("/js/afterLoad.js");
            // Do whatever you want to do after script is ready
        });
    </script>
}


