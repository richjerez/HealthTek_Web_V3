@model HealthTek_Shared_Libraries.Preferences
<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Create" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="FkClientsId" />
                <div class="form-group">
                    <label asp-for="FkReinforcersCatalogId" class="control-label"></label>
                    <select asp-for="FkReinforcersCatalogId" class="ModalSelect" data-live-search="true" asp-items="ViewBag.FkReinforcersCatalogId"></select>
                </div>
                <div class="form-group">
                    <label asp-for="Preference" class="control-label"></label>
                    <input asp-for="Preference" class="form-control" />
                    <span asp-validation-for="Preference" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Source" class="control-label"></label>
                    <input asp-for="Source" class="form-control" />
                    <span asp-validation-for="Source" class="text-danger"></span>
                </div>
        @{await Html.RenderPartialAsync("~/Views/Shared/_SubmitButton.cshtml","Create");}
            </form>
        </div>
    </div>
</div>