@model HealthTek_Shared_Libraries.MaladaptiveMeasurements

<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Create" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="FkMaladaptivesId" type="hidden" />
                <input asp-for="CreationDate" type="hidden" />
                <input asp-for="DateMeasured" type="hidden" />
                <div class="form-group">
                    <label asp-for="FkMaladaptives.MaladaptiveName" class="control-label"></label>
                    <input asp-for="FkMaladaptives.MaladaptiveName" class="form-control" disabled />
                    <span asp-validation-for="FkMaladaptives.MaladaptiveName" class="text-danger"></span>
                </div>
                <div class="form-group" id="frequency">
                    <label asp-for="Frequency" class="control-label"></label>
                    <input asp-for="Frequency" class="form-control" />
                    <span asp-validation-for="Frequency" class="text-danger"></span>
                </div>

                <div class="form-group d-none" id="successfulTrials">
                    <label asp-for="SuccessfulTrials" class="control-label"></label>
                    <input asp-for="SuccessfulTrials" class="form-control" />
                    <span asp-validation-for="SuccessfulTrials" class="text-danger"></span>
                </div>
                <div class="form-group d-none" id="totalTrials">
                    <label asp-for="TotalTrials" class="control-label"></label>
                    <input asp-for="TotalTrials" class="form-control" />
                    <span asp-validation-for="TotalTrials" class="text-danger"></span>
                </div>
                <div class="form-group d-none" id="duration">
                    <label asp-for="Duration" class="control-label"></label>
                    <input asp-for="Duration" class="form-control" />
                    <span asp-validation-for="Duration" class="text-danger"></span>
                </div>
                <div class="form-group d-none" id="durationunit">
                    <label asp-for="DurationUnit" class="control-label"></label>
                    <select asp-for="DurationUnit" class="ModalSelect mb-2" asp-items="ViewBag.TimeFrame">
                        <option disabled selected>Select Duration Unit</option>
                    </select>
                    <span asp-validation-for="DurationUnit" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="InterventionsUsedList"></label>
                    <select class="ModalSelect" asp-for="InterventionsUsedList" data-live-search="true" asp-items="ViewBag.Interventions" multiple>
                        <option disabled>Select Interventions</option>
                    </select>
                    <span asp-validation-for="InterventionsUsedList" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MaladaptiveMeasureComment" class="control-label"></label>
                    <textarea asp-for="MaladaptiveMeasureComment" class="form-control"></textarea>
                    <span asp-validation-for="MaladaptiveMeasureComment" class="text-danger"></span>
                </div>
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/_SubmitButton.cshtml", "Create");
                }
            </form>
        </div>
    </div>
</div>
@if (Model.FkMaladaptives != null)
{
    <script>
        var freq = '@Html.Raw(Model.FkMaladaptives.CollectionMethod??"Duration")';
        changeFreq(freq);
    </script>
}

