@model IEnumerable<HealthTek_Shared_Libraries.Clients>
@{
    var id = ViewData["ID"];
}
<div class="card shadow mb-4 p-3">
    <!-- Card Header - Accordion -->
    <a href="#collapseAddresses" class="d-block card-header py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseAddresses">
        <h6 class="m-0 font-weight-bold text-primary">Clients</h6>
    </a>
    <!-- Card Content - Collapse -->
    <div class="collapse show" id="collapseAddresses" style="">
        <div class="card-body">
            <a class="btn btn-primary float-right" asp-controller="Clients" asp-action="Create">
                New Client
            </a>
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>
                                Chart Number
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Phone Number
                            </th>
                            <th style="text-align: center; padding-right: 11px;">
                                Status
                            </th>
                            <th>
                                Auth Note
                            </th>
                        </tr>
                    </thead>
                    <tbody id="TableBody">
                        @if (Model != null)
                        {
                            @foreach (var item in Model)
                            {
                                <tr ondblclick="LoadEdit('@item.ClientsId','Clients')">
                                    <td>
                                        @item.ClientsFacilities.FirstOrDefault().ChartNumber
                                    </td>
                                    <td>
                                        <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.ClientsId" class="FullName">@Html.DisplayFor(modelItem => item.FullName)</a>
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MainPhoneNumber)
                                    </td>
                                    <td>
                                        <a class="status-@item.ClientStatus">@Html.DisplayFor(modelItem => item.ClientStatus)</a>
                                    </td>
                                    <td>
                                        @if (item.Authorizations.Count != 0 && item.Authorizations.FirstOrDefault().AuthorizationNotes.Count != 0)
                                        {
                                            <small>@item.Authorizations.FirstOrDefault().AuthorizationNotes.FirstOrDefault().Notes</small>
                                        }
                                        else
                                        {
                                            <small>No Note To display</small>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


