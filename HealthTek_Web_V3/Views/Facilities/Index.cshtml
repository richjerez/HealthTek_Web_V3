@model IEnumerable<HealthTek_Shared_Libraries.Facilities>

@{
    ViewData["Title"] = "Facilities";
    ViewData["SingularTitle"] = "Facility";
}
@section Styles{
<!-- Custom styles for this page -->
<link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
}

<div class="">
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-4">
                    <h6 class="m-0 font-weight-bold text-primary datatitle">
                        @ViewData["Title"]<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;" onclick="AddEditElements(0, 'Facilities')"></i>
                    </h6>
                </div>
                <div class="col-md-8 text-right">
                    <button onclick="AddEditElements(0, 'Facilities')" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus fa-sm text-white-50"></i>
                        </span>
                        <span class="text">New @ViewData["SingularTitle"]</span>
                    </button>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="window.print()">
                        <span class="icon text-white-50">
                            <i class="fas fa-print fa-sm text-white-50"></i>
                        </span>
                        <span class="text">Print</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" asp-controller="Report" asp-action="Get" asp-route-ClassName="Facilities" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-pdf fa-sm text-white-50"></i>
                        </span>
                        <span class="text">PDF</span>
                    </a>
                    <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="ExportCSV('Facilities',2)">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-csv fa-sm text-white-50"></i>
                        </span>
                        <span class="text">CSV</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>Name</th>
                            <th>
                                Type
                            </th>
                            <th>
                                Director
                            </th>
                            <th>
                                Region
                            </th>
                            <th>
                                Website
                            </th>
                            <th data-orderable="false"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr ondblclick="AddEditElements('@item.FacilitiesId', 'Facilities')">
                                <td>
                                    <a asp-controller="Facilities" asp-action="Details" asp-route-id="@item.FacilitiesId">
                                        @Html.DisplayFor(modelItem => item.FacilityName) (@item.FacilityInitials)
                                    </a>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.FacilityType)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Supervisor)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Locations.Region)
                                </td>
                                <td>
                                    <a href="@item.FacilityUrl">
                                        @Html.DisplayFor(modelItem => item.FacilityUrl)
                                    </a>
                                </td>
                                <td class="text-right">
                                    <button onclick="DeleteElement('@item.FacilitiesId', 'Facilities')" class="btn btn-outline-danger d-print-none">
                                        <span class="text">
                                            <i class="fa fa-trash"></i>
                                        </span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{

<!-- Page level plugins -->
<script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
<script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

<!-- Page level custom scripts -->
<script src="~/js/demo/datatables-demo.js"></script>

<!-- CSV Export scripts -->
<script type="text/javascript" src="~/js/Exports/CSVExport.js"></script>

<!-- Page level custom scripts starts -->
<script src="~/js/demo/datatables-demo.js"></script>
<script>
    $(document).ready(async function () {
        await loadScript("/js/afterLoad.js");
        await loadScript("/js/Cruds/Facilities.js");

        // Do whatever you want to do after script is ready
    });
</script>
}