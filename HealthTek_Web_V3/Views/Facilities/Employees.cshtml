@model IEnumerable<HealthTek_Shared_Libraries.Employees>
@{
    var id = ViewData["ID"];
}
<div class="card shadow mb-4 p-3">
    <!-- Card Header - Accordion -->
    <a href="#collapseAddresses" class="d-block card-header py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseAddresses">
        <h6 class="m-0 font-weight-bold text-primary">Employees</h6>
    </a>
    <!-- Card Content - Collapse -->
    <div class="collapse show" id="collapseAddresses" style="">
        <div class="card-body">
            <a class="btn btn-primary float-right" asp-controller="Employees" asp-action="Create">
                New Employee
            </a>
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th class="text-center pl-4">
                                Status
                            </th>
                            <th>
                                Employee
                            </th>
                            <th>
                                Phone
                            </th>
                            <th>
                                Email
                            </th>
                            <th>
                                Address
                            </th>
                            <th>
                                Gender
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            @if (item != null)
                            {
                                <tr ondblclick="LoadEdit('@item.EmployeesId', 'Employees')">
                                    <td>
                                        <a class="status-@item.EmployeeStatus">@item.EmployeeStatus</a>
                                    </td>
                                    <td>
                                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@item.EmployeesId">
                                            @item.EmployeeLabel
                                        </a>
                                    </td>
                                    <td>
                                        @item.PhoneNumber
                                    </td>
                                    <td>
                                        @item.Email
                                    </td>
                                    <td>
                                        @item.Locations.FullPrimaryAddress
                                    </td>
                                    <td>
                                        @item.Gender
                                    </td>
                                </tr>

                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

