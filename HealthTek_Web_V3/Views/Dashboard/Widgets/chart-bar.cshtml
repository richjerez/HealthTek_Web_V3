@model HealthTek_Shared_Libraries.Widgets
@{
    var id = String.Concat(Model.WidgetName.Where(c => !Char.IsWhiteSpace(c)));
    var idup = id + "gr";
}


<!-- Bar Chart -->
<div class="card shadow mb-4" draggable="true" ondragstart="drag(event)" id="@idup">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">@Model.WidgetName</h6>
    </div>
    <div class="card-body">
        <div class="chart-bar">
            <canvas id="@id"></canvas>
        </div>
    </div>
</div>

<script>
    selectChart('@Model.ClassName','@id');
</script>