@model HealthTek_Shared_Libraries.Employees
<div class="card shadow mb-4 p-3">
    <!-- Card Header - Accordion -->
    <a href="#collapseHrChart" class="d-block card-header py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseHrChart">
        <h6 class="m-0 font-weight-bold text-primary">HR Chart</h6>
    </a>
    <!-- Card Content - Collapse -->
    <div class="collapse show" id="collapseHrChart" style="">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-5">
                    <h6>Employee Facts</h6>
                    <hr>
                    <div class="row">
                        <div class="col-lg-12">
                            <small class="d-block font-weight-bold">Hired Date</small>
                            <span class="d-block">@Model.HireDate?.ToShortDateString()</span>
                            @if (@Model.EmployeeIdentifier != null)
                            {
                                <small class="d-block font-weight-bold mt-2">National Provider Identifier</small>
                                <span class="d-block">@Model.EmployeeIdentifier</span>
                            }
                            @if (Model.IdentifierEffectiveDate.HasValue)
                            {
                                                            <small class="d-block font-weight-bold mt-2">NPI Registration Date</small>
                                <span class="d-block">@Model.IdentifierEffectiveDate?.ToShortDateString()</span>
                            }
                            @if (@Model.ReferralSource != null)
                            {
                                <small class="d-block font-weight-bold mt-2">Reference Source</small>
                                <span class="d-block">@Model.ReferralSource</span>
                            }
                            @if (Model.LicenseNumber != null)
                            {
                                <small class="d-block font-weight-bold mt-2">License Number</small>
                                <span class="d-block">@Model.LicenseNumber</span>
                            }
                            <small class="d-block font-weight-bold mt-2">Highest Level of Education</small>
                            <span class="d-block">@Model.HighestEducation</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-1">
                    <div class="divider d-none d-sm-block"></div>
                </div>
                <div class="col-lg-6">
                    <h6>Identity Summary</h6>
                    <hr>
                    <div class="col-lg-12">
                        <small class="d-block font-weight-bold mt-2">SSN</small>
                        @if (!string.IsNullOrEmpty(Model.Ssn))
                        {
                            <span class="text">XXX-XX-@Model.Ssn.Substring(7)</span>
                        }
                        <small class="d-block font-weight-bold mt-2">Date of Birth</small>
                        <span class="d-block">@Model.Dob?.ToShortDateString()</span>
                        <small class="d-block font-weight-bold mt-2">Languages</small>
                        <span class="d-block">@Model.Languages</span>
                        <small class="d-block font-weight-bold mt-2">Gender</small>
                        <span class="d-block">@Model.Gender</span>
                        <small class="d-block font-weight-bold mt-2">Ethnicity</small>
                        <span class="d-block">@Model.Ethnicity</span>
                        <small class="d-block font-weight-bold mt-2">Religion</small>
                        <span class="d-block">@Model.Religion</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Card Header - Accordion -->
    <a href="#collapseDocuments" class="d-block card-header py-3 collapsed" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="collapseDocuments">
        <h6 class="m-0 font-weight-bold text-primary">HR Documents</h6>
    </a>
    <!-- Card Content - Collapse -->
    <div class="collapse" id="collapseDocuments" style="">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th data-orderable="false" class="d-print-none"></th>
                            <th>Role</th>
                            <th>Title</th>
                            <th>
                                Effective
                            </th>
                            <th>
                                Expiration
                            </th>
                            <th data-orderable="false" class="d-print-none"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DocumentationProcess)
                        {
                            var docs = item.FkDocuments;
                            if (docs != null)
                            {
                                <tr ondblclick="AddEditElements(@item.DocumentationProcessId, 'DocumentationProcesses')">
                                    <td>@Html.DisplayFor(mbox => docs.IsAttached)</td>
                                    <td>@item.Role</td>
                                    <td>
                                        @Html.DisplayFor(modelItem => docs.DocumentTitle)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => docs.DocumentEffectiveDate)
                                    </td>
                                    <td>
                                        @if (docs.DocumentExpirationDate != null)
                                        {
                                            @Html.DisplayFor(modelItem => docs.DocumentExpirationDate)
                                        }
                                        else
                                        {
                                            @Html.DisplayFor(modelItem => item.RoleDocsCatalogs.Expiration)
                                        }

                                    </td>
                                    <td class="text-right d-print-none">
                                        <button onclick="DeleteElement(@docs.DocumentsId, 'Documents')" href="#" class="btn btn-outline-danger ">
                                            <span class="text">
                                                <i class="fa fa-trash"></i>
                                            </span>
                                        </button>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td><input value="false" type="checkbox" disabled /></td>
                                    <td>@item.Role</td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.RoleDocsCatalogs.Title)
                                    </td>
                                    <td>
                                        On upload
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.RoleDocsCatalogs.Expiration)
                                    </td>
                                    <td class="text-right">
                                        <button class="btn btn-primary float-right" onclick="AddEditElements(@item.DocumentationProcessId, 'DocumentationProcesses')">
                                            Upload Document
                                        </button>
                                    </td>
                                </tr>
                            }

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

