@model IEnumerable<HealthTek_Shared_Libraries.Employees>
@{
    ViewData["Title"] = "Employees";
    ViewData["ActivePage"] = "Employees";
}
@section Styles{
    <!-- Custom styles for this page -->
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
}

<div class="">
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="m-0 font-weight-bold text-primary datatitle">
                        Employees<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;" onclick="AddEditElements(0, 'Employees')"></i>
                    </h6>
                </div>
                <div class="col-md-6 text-right">
                    <a asp-controller="Employees" asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus fa-sm text-white-50"></i>
                        </span>
                        <span class="text">New Employee</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="window.print()">
                        <span class="icon text-white-50">
                            <i class="fas fa-print fa-sm text-white-50"></i>
                        </span>
                        <span class="text">Print</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none"
                           asp-controller="Report" asp-action="Get" asp-route-ClassName="Employees" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-pdf fa-sm text-white-50"></i>
                        </span>
                        <span class="text">PDF</span>
                    </a>
                    <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="ExportCSV('Employees',6)">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-csv fa-sm text-white-50"></i>
                        </span>
                        <span class="text">CSV</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th class="text-center pl-4">
                                Status
                            </th>
                            <th>
                                Employee
                            </th>
                            <th>
                                Phone
                            </th>
                            <th>
                                Email
                            </th>
                            <th>
                                Address
                            </th>
                            <th>
                                Gender
                            </th>
                            <th data-orderable="false"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr ondblclick="LoadEdit('@item.EmployeesId', 'Employees')">
                                <td>
                                    <a class="status-@item.EmployeeStatus">@Html.DisplayFor(modelItem => item.EmployeeStatus)</a>
                                </td>
                                <td>
                                    <a asp-controller="Employees" asp-action="Details" asp-route-id="@item.EmployeesId">
                                        @Html.DisplayFor(modelItem => item.EmployeeLabel)
                                    </a>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Email)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Locations.FullPrimaryAddress)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Gender)
                                </td>
                                <td class="text-right">
                                    <button onclick="DeleteElement('@item.EmployeesId', 'Employees')" class="btn btn-outline-danger d-print-none">
                                        <span class="text">
                                            <i class="fa fa-trash"></i>
                                        </span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{

    <!-- Page level plugins -->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/js/demo/datatables-demo.js"></script>
    <!-- CSV Export scripts -->
    <script type="text/javascript" src="~/js/Exports/CSVExport.js"></script>



    <!-- Page level custom scripts starts -->
    <script src="~/js/demo/datatables-demo.js"></script>
    <script>
        $(document).ready(async function () {
            await loadScript("/js/afterLoad.js");
            // Do whatever you want to do after script is ready
        });

    </script>

}
