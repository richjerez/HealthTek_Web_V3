@model HealthTek_Shared_Libraries.Employees
@{
    ViewData["Title"] = "Employee Profile";
    ViewData["ActivePage"] = "Employees";
}
@section Styles{
    <!-- Custom styles for this page -->
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
    <link href='/css/main.css' rel='stylesheet' />
    <script src='/js/fullCalendar/main.js' type="text/javascript"></script>
}

    <div class="card shadow mb-4">
        <a class="d-block card-header py-3" onclick="LoadEdit('@Model.EmployeesId', 'Employees')" href="#">
            <i class="fas fa-user-edit text-primary float-right"></i>
            <h6 class="m-0 font-weight-bold text-primary">Employee Profile</h6>
        </a>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3">
                    <h6>Quick Facts</h6>
                    <hr>
                    <div class="row">
                        <div class="col-lg-12 text-center">
                            <img class="img-profile rounded-block m-auto d-block"
                             src="@Model.AvatarUrl" style="width: 200px;height: 200px;">
                            <span class="d-block font-weight-bold">
                                @Model.EmployeeLabel
                            </span>
                            <hr />
                        </div>
                        <div class="col-lg-12">
                            <small class="d-block font-weight-bold">Provider#</small>
                            <span class="d-block">@Model.ProviderNumber</span>
                            <div class="row">
                                <div class="col-lg-6">
                                    <small class="d-block font-weight-bold">Main Phone</small>
                                    <span class="d-block">@Model.PhoneNumber</span>
                                </div>
                                <div class="col-lg-6">
                                    <small class="d-block font-weight-bold">Alternate Phone</small>
                                    <span class="d-block">@Model.AlternateNumber</span>
                                </div>
                            </div>
                            <small class="d-block font-weight-bold">Address</small>
                            <span class="d-block">@Model.Locations.FullPrimaryAddress</span>
                            <small class="d-block font-weight-bold">Email</small>
                            <a class="d-block" href="@Model.Email">@Model.Email</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-1">
                    <div class="divider d-none d-sm-block"></div>
                </div>
                <div class="col-lg-3">
                    <h6>Dashboard</h6>
                    <hr>
                    <small class="d-block font-weight-bold">Open Tasks</small>
                    <a class="d-inline-block status-warning mr-1 mb-1" style="min-width: 32px; vertical-align: revert; padding: 7px; ">@ViewData["OpenTasks"]</a>
                    <button onclick="AddEditElements(0, 'Tasks', false, '@Model.EmployeesId')" class="btn btn-outline-primary d-print-none">
                        <span class="text">
                            <i class="fa fa-plus"></i>
                        </span>
                    </button>

                    <small class="d-block font-weight-bold">Facilities</small>
                    <div>
                        @foreach (var facility in Model.EmployeesFacilities)
                    {
                        <a class="d-inline-block status-success mr-1 mb-1" style="vertical-align:middle" onclick="AddEditElements(@facility.EmployeesFacilitiesId,'EmployeesFacilities')" href="#"><small class="d-block font-weight-bold mt-2 text-left">@facility.FkFacilities.FacilityInitials</small><span>@facility.FkFacilities.FacilityName</span></a>
                    }
                    <button onclick="AddEditElements(0, 'EmployeesFacilities', false, '@Model.EmployeesId')" class="btn btn-outline-primary d-print-none mt-0">
                        <span class="text">
                            <i class="fa fa-plus"></i>
                        </span>
                    </button>
                </div>
                <small class="d-block font-weight-bold mt-2">Roles</small>
                <div>
                    @foreach (var facility in Model.EmployeesRoleNames)
                    {
                        <a class="d-inline-block status-success mr-1 mb-1" onclick="AddEditElements(@facility.EmployeesRoleNamesId,'EmployeesRoleNames')" style="vertical-align:middle" href="#"><span>@facility.FkRoleNames.RoleName</span></a>
                    }
                    <button onclick="AddEditElements(0, 'EmployeesRoleNames', false, '@Model.EmployeesId')" class="btn btn-outline-primary d-print-none mt-0">
                        <span class="text">
                            <i class="fa fa-plus"></i>
                        </span>
                    </button>
                </div>
                <small class="d-block font-weight-bold">Operating Counties</small>
                <div>
                    @foreach (var facility in Model.EmployeesOperatingCounties)
                    {
                        <a class="d-inline-block status-success mr-1 mb-1" style="vertical-align:middle" onclick="AddEditElements(@facility.EmployeesOperatingCountiesId,'EmployeesOperatingCounties')" href="#"><span>@facility.FkOperatingCounties.County</span></a>
                    }
                    <button onclick="AddEditElements(0, 'EmployeesOperatingCounties', false, '@Model.EmployeesId')" class="btn btn-outline-primary d-print-none mt-0">
                        <span class="text">
                            <i class="fa fa-plus"></i>
                        </span>
                    </button>
                </div>
                <small class="d-block font-weight-bold">Assignments</small>
                <div>
                    @foreach (var assignment in Model.Assignments.Where(m => m.AssignmentPosition != null))
                    {
                        var delimiter = ", ";
                        <a asp-controller="Clients" asp-action="Details"
                       asp-route-id="@assignment.FkClientsId" class="d-inline-block">@assignment.FkClients.FullName</a>
                        if (assignment != Model.Assignments.Where(m => m.AssignmentPosition != null).Last())
                        {
                            @delimiter
                        }
                    }
                </div>
            </div>
            <div class="col-lg-1">
                <div class="divider d-none d-sm-block"></div>
            </div>
            <div class="col-lg-4">
                <h6>
                    HR Summary
                    <a class="status-@Model.EmployeeStatus d-block float-right" data-toggle="modal" data-target="#StatusModal" href="#">@Html.DisplayFor(modelItem => Model.EmployeeStatus) Employee</a>
                </h6>
                <hr>
                <div class="col-lg-12">
                    @if (Model.IsHrReady)
                    {
                        <small class="d-block font-weight-bold">HR Readiness</small>
                        <a class="status-success d-inline-block mb-2" href="#">Ready</a>
                        <small class="d-block font-weight-bold">Since</small>
                        if (Model.HireDate != null)
                        {
                            <span class="d-block mb-2">@Model.HireDate?.ToShortDateString()</span>
                        }
                    }
                    else
                    {
                        <small class="d-block font-weight-bold">HR Readiness</small>
                        <a class="status-danger d-inline-block mb-2" href="#">Not-Ready</a>

                    }
                    @if (Model.FkESignatures != null)
                    {
                        <small class="d-block font-weight-bold">E-Signature</small>
                        <a class="status-success d-inline-block" href="#">Captured</a>
                    }
                    else
                    {
                        <small class="d-block font-weight-bold">E-Signature</small>
                        <a class="status-danger d-inline-block" href="#">Empty</a>

                    }
                    <small class="d-block font-weight-bold mt-2">Interviewed On</small>
                    @if (Model.InterviewDate != null)
                    {
                        <span class="d-block">@Model.InterviewDate?.ToShortDateString()</span>
                    }
                    <small class="d-block font-weight-bold mt-2">HR Requirements</small>
                    <a class="d-inline-block status-success mr-1 mb-1"><small>Uploaded</small><span class="d-block">@ViewBag.UploadedDocs</span></a>
                    <a class="d-inline-block status-danger mr-1 mb-1"><small>Expired</small><span class="d-block">@ViewBag.ExpiredDocs</span></a>
                    <a class="d-inline-block status-warning mr-1 mb-1"><small>Expiring</small><span class="d-block">@ViewBag.ExpiringDocs</span></a>
                    <small class="d-block font-weight-bold mt-2">Weekly Billing</small>
                    <a class="d-inline-block status-success mr-1 mb-1"><small>Rate</small><span class="d-block">$@Math.Round(Model.EmployeeRate.Value, 2)</span></a>
                    <a class="d-inline-block status-primary mr-1 mb-1"><small>Avg</small><span class="d-block">$@Math.Round(ViewBag.Avg, 2)</span></a>
                    <a class="d-inline-block status-Tertiary mr-1 mb-1"><small>Total</small><span class="d-block">$@Math.Round(ViewBag.Total, 2)</span></a>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Nav tabs -->
<ul class="nav nav-tabs" id="myTab" role="tablist" style="float: none!important;">
    @foreach (var item in ViewBag.Tabs)
    {
        <li class="nav-item">
            <a class="nav-link @item.Active" asp-action="Details" asp-route-id="@Model.EmployeesId" asp-route-table="@item.Name">@item.Name</a>
        </li>
    }
</ul>
<!-- Tab panes -->
<div class="tab-content">
    <div class="tab-pane active" id="@ViewBag.TableName" role="tabpanel" aria-labelledby="home-tab">
        <partial name="@ViewBag.TableName" model="@ViewBag.Table" />
    </div>
</div>

<!-- Status Modal-->
<div class="modal fade" id="StatusModal" tabindex="-1" role="dialog" aria-labelledby="StatusModalLabel"
     aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content bg-white text-dark">
            <div class="modal-header">
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
                <h5 class="modal-title" id="StatusModalLabel">Manage Employee</h5>
                <h6>Employment Status</h6>
            </div>
            <div class="modal-body">
                <div class="card shadow p-3">
                    <form asp-action="ChangeEmploymentStatus" method="post" onsubmit="return jQueryAjaxPost(this);">
                        <input type="hidden" asp-for="EmployeesId" />
                        <div class="form-group">
                            <label asp-for="EmployeeStatus" class="control-label"></label>
                            <select asp-for="EmployeeStatus" class="form-control" asp-items="ViewBag.Status"></select>
                        </div>
                        <div class="form-group mb-0">
                            <div class="checkbox">
                                <label><input type="checkbox" asp-for="@Model.IsHrReady" value="@Model.IsHrReady"> Is Hr-Ready</label>
                            </div>
                            <span asp-validation-for="IsHrReady" class="text-danger"></span>
                        </div>
                        <div class="form-group m-r-20 text-md-right mb-0">
                            <input type="submit" id="submitBtn" value="Save" class="btn btn-primary" />
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{

    <!-- Page level plugins -->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/js/demo/datatables-demo.js"></script>
    <!-- CSV Export scripts -->
    <script type="text/javascript" src="~/js/Exports/CSVExport.js"></script>
    <script src="/js/Cruds/Appointments.js"></script>
    <script src="/js/Cruds/Employees.js"></script>

    <!-- Page level custom scripts starts -->
    <script src="~/js/demo/datatables-demo.js"></script>
    <script>
        $(document).ready(async function() {
            await loadScript("/js/afterLoad.js");
            // Do whatever you want to do after script is ready

        });
    </script>
    <script src="~/js/Cruds/Documents.js"></script>

}
