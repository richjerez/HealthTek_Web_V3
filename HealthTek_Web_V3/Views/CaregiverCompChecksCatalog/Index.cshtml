@model IEnumerable<HealthTek_Shared_Libraries.CaregiverCompChecksCatalog>

@{
    ViewData["Title"] = "CCC Training Items Catalog";
    ViewData["SingularTitle"] = "CCC Training";
}

@section Styles{
    <!-- Custom styles for this page -->
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
}

<div class="container">
    <div class="card shadow mb-8">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-4">
                    <h6 class="m-0 font-weight-bold text-primary datatitle">
                        @ViewData["Title"]<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;" onclick="AddEditElements(0, 'CaregiverCompChecksCatalog')"></i>
                    </h6>
                </div>
                <div class="col-md-8 text-right">
                    <button onclick="AddEditElements(0, 'CaregiverCompChecksCatalog')" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus fa-sm text-white-50"></i>
                        </span>
                        <span class="text">New @ViewData["SingularTitle"]</span>
                    </button>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="window.print()">
                        <span class="icon text-white-50">
                            <i class="fas fa-print fa-sm text-white-50"></i>
                        </span>
                        <span class="text">Print</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" 
                    asp-controller="Report" asp-action="Get" asp-route-ClassName="CaregiverCompChecksCatalog" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-pdf fa-sm text-white-50"></i>
                        </span>
                        <span class="text">PDF</span>
                    </a>
                    <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="ExportCSV('CaregiverCompChecksCatalog',1)">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-csv fa-sm text-white-50"></i>
                        </span>
                        <span class="text">CSV</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.TrainingItem)
                            </th>
                            <th data-orderable="false" class="d-print-none"></th>
                        </tr>
                    </thead>
                    <tbody id="TableBody">
                        @foreach (var item in Model)
                        {
                            <tr ondblclick="AddEditElements('@item.CaregiverCompChecksCatalogId', 'CaregiverCompChecksCatalog')">
                                <td>
                                    @Html.DisplayFor(modelItem => item.TrainingItem)
                                </td>
                                <td class="text-right d-print-none">
                                    <button onclick="DeleteElement('@item.CaregiverCompChecksCatalogId', 'CaregiverCompChecksCatalog')" href="#" class="btn btn-outline-danger ">
                                        <span class="text">
                                            <i class="fa fa-trash"></i>
                                        </span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <!-- Page level plugins -->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/js/demo/datatables-demo.js"></script>

    <!-- CSV Export scripts -->
    <script type="text/javascript" src="~/js/Exports/CSVExport.js"></script>
}