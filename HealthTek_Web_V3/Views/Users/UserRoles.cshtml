@model IEnumerable<AppRolesModel>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="card-body">
        <div class="row">
            @foreach (var role in Model)
            {
                var check = "";
                if (role.Flag)
                {
                    check = "checked";
                }
                <div class="col-md-4">
                    <div class="row no-gutters p-2 border-bottom border-right">
                        <div class="col-md-8">
                            @role.Role
                        </div>
                        <div class="col-md-4 text-right">
                        <!-- Default unchecked -->
                        <div class="custom-control custom-switch">
                            <input type="checkbox" class="custom-control-input" id="@role.Role" name="@role.Role" value="@role.Flag" @check>
                            <label class="custom-control-label" for="@role.Role" onclick="togglePermission('@role.Role')"></label>
                        </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</form>
<script>
    function togglePermission(name) {
        var url = "/Users/TogglePermission/"
        var userId = '@Html.Raw(ViewBag.UserId)';
        var postObj = JSON.stringify({ id: userId, role: name });
        var response = fetch(url, { method: "POST", body: postObj, headers: { 'Content-Type': 'application/json' } });
    }
</script>