@model HealthTek_Shared_Libraries.Intakes
        <div class="card shadow p-3">
            <form asp-action="Edit" class="row" onsubmit="return jQueryAjaxPost(this);">
                <div class="col-xl-12">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="CreationDate" />
                    <input asp-for="IntakesId" type="hidden" />
                    <div class="form-group">
                        <label asp-for="FkFacilitiesId" class="control-label"></label>
                        <select asp-for="FkFacilitiesId" class="ModalSelect" asp-items="ViewBag.Facilities"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="FkClientsId" class="control-label"></label>
                        <select asp-for="FkClientsId" class="ModalSelect" asp-items="ViewBag.FkClientsId" data-live-search="true"></select>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="IntakeEffectiveDate" class="control-label"></label>
                                <input asp-for="IntakeEffectiveDate" class="form-control"  type="date" asp-format="{0:yyy-MM-dd}"/>
                                <span asp-validation-for="IntakeEffectiveDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="IntakeExpirationDate" class="control-label"></label>
                                <input asp-for="IntakeExpirationDate" class="form-control"  type="date" asp-format="{0:yyy-MM-dd}"/>
                                <span asp-validation-for="IntakeExpirationDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="IntakeStatus" class="control-label"></label>
                        <select asp-for="IntakeStatus" class="ModalSelect" asp-items="ViewBag.Status"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="StatusNote" class="control-label"></label>
                        <textarea asp-for="StatusNote" class="form-control"></textarea>
                        <span asp-validation-for="StatusNote" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="form-group text-right mb-0">
                        <input type="submit" value="Save" class="btn btn-primary" />
                    </div>
                </div>
            </form>
        </div>
