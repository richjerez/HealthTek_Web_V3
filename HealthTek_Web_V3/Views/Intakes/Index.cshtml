@model IEnumerable<HealthTek_Shared_Libraries.Intakes>
@{
    ViewData["Title"] = "Intakes";
    ViewData["ActivePage"] = "Intakes";
    var discovery = Model.Where(m => m.IntakeStatus == "Discovery").ToList();
    var processing = Model.Where(m => m.IntakeStatus == "Processing").ToList();
    var trouble = Model.Where(m => m.IntakeStatus == "Troubleshooting").ToList();
    var completed = Model.Where(m => m.IntakeStatus == "Completed").ToList();
}
@section Styles{
    <!-- Custom styles for this page -->
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
}

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-4">
                    <h6 class="m-0 font-weight-bold text-primary datatitle">
                        @ViewData["Title"]<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;"></i>
                    </h6>
                </div>
                <div class="col-md-8 text-right">
                    <a onclick="AddEditElements(0, 'Intakes')" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus fa-sm text-white-50"></i>
                        </span>
                        <span class="text">New @ViewData["Title"]</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="window.print()">
                        <span class="icon text-white-50">
                            <i class="fas fa-print fa-sm text-white-50"></i>
                        </span>
                        <span class="text">Print</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none"
                   asp-controller="Report" asp-action="Get" asp-route-ClassName="Intakes" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-pdf fa-sm text-white-50"></i>
                        </span>
                        <span class="text">PDF</span>
                    </a>
                    <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="ExportCSV('Intakes',5)">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-csv fa-sm text-white-50"></i>
                        </span>
                        <span class="text">CSV</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>
                                Initiated
                            </th>
                            <th>
                                Facility
                            </th>
                            <th>
                                Client
                            </th>
                            <th>
                                Originator
                            </th>
                            <th>
                                Status
                            </th>
                            <th>
                                Note
                            </th>
                            <th data-orderable="false"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                    {
                        <tr ondblclick="AddEditElements('@item.IntakesId', 'Intakes')">
                            <td>
                                @Html.DisplayFor(modelItem => item.IntakeEffectiveDate)
                            </td>
                            <td>
                                <a asp-controller="Facilities" asp-action="Details" asp-route-id="@item.FkFacilities.FacilitiesId">
                                    @item.FkFacilities.FacilityName
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.FkClients.ClientsId">
                                    @Html.DisplayFor(modelItem => item.FkClients.FullName)
                                </a>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FkClients.Originator)
                            </td>
                            <td>
                                <a class="status-@item.IntakeStatus">@Html.DisplayFor(modelItem => item.IntakeStatus)</a>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.StatusNote)
                            </td>
                            <td class="text-right d-print-none">
                                <a style="text-decoration:none" onclick="AddEditElements(@item.IntakesId, 'Intakes', true)" class="btn btn-outline-info d-print-none">
                                    <span class="text">
                                        <i class="fa fa-server"></i>
                                    </span>
                                </a>
                                <button onclick="DeleteElement(@item.IntakesId, 'Intakes')" class="btn btn-outline-danger d-print-none">
                                    <span class="text">
                                        <i class="fa fa-trash"></i>
                                    </span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="row d-print-none">
    <div class="col-lg-3">
        <div class="card shadow mb-4">
            <!-- Card Header - Accordion -->
            <a href="#DiscoveryCollapse" class="d-block card-header bg-primary py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="DiscoveryCollapse">
                <h6 class="m-0 font-weight-bold text-white">Discovery</h6>
            </a>
            <!-- Card Content - Collapse -->
            <div class="collapse show" id="DiscoveryCollapse">
                <div class="card-body" ondrop="dropKanban(event,this)" ondragover="allowDrop(event)" id="Discovery" name="primary">
                    @foreach (var item in discovery)
                    {
                        <div class="card border-left-primary shadow p-2 mb-4" draggable="true" ondragstart="drag(event,'primary')" id="@item.IntakesId" ondrop="allowDrop(event)">
                            <small class="badge-secondary float-right p-1" style="border-radius:5px">@item.FkFacilities.FacilityInitials</small>
                            <small class="font-weight-bold d-block">Client</small>
                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.FkClientsId">@item.FkClients.FullName</a>
                            <small class="font-weight-bold d-block">Effective</small>
                            @item.IntakeEffectiveDate.Value.ToShortDateString()
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card shadow mb-4">
            <!-- Card Header - Accordion -->
            <a href="#ProcessingCollapse" class="d-block card-header bg-warning py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="ProcessingCollapse">
                <h6 class="m-0 font-weight-bold text-white">Processing</h6>
            </a>
            <!-- Card Content - Collapse -->
            <div class="collapse show" id="ProcessingCollapse">
                <div class="card-body" ondrop="dropKanban(event,this)" ondragover="allowDrop(event)" id="Processing" name="warning">
                    @foreach (var item in processing)
                    {
                        <div class="card border-left-warning shadow p-2 mb-4" draggable="true" ondragstart="drag(event,'warning')" id="@item.IntakesId" ondrop="allowDrop(event)">
                            <small class="badge-secondary float-right p-1" style="border-radius:5px">@item.FkFacilities.FacilityInitials</small>
                            <small class="font-weight-bold d-block">Client</small>
                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.FkClientsId">@item.FkClients.FullName</a>
                            <small class="font-weight-bold d-block">Effective</small>
                            @item.IntakeEffectiveDate.Value.ToShortDateString()
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card shadow mb-4">
            <!-- Card Header - Accordion -->
            <a href="#TroubleshootingCollapse" class="d-block card-header bg-danger py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="TroubleshootingCollapse">
                <h6 class="m-0 font-weight-bold text-white">Troubleshooting</h6>
            </a>
            <!-- Card Content - Collapse -->
            <div class="collapse show" id="TroubleshootingCollapse">
                <div class="card-body" ondrop="dropKanban(event,this)" ondragover="allowDrop(event)" id="Troubleshooting" name="danger">
                    @foreach (var item in trouble)
                    {
                        <div class="card border-left-danger shadow p-2 mb-4" draggable="true" ondragstart="drag(event,'danger')" id="@item.IntakesId" ondragover="return false;" ondrop="return false;">
                            <small class="badge-secondary float-right p-1" style="border-radius:5px">@item.FkFacilities.FacilityInitials</small>
                            <small class="font-weight-bold d-block">Client</small>
                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.FkClientsId">@item.FkClients.FullName</a>
                            <small class="font-weight-bold d-block">Effective</small>
                            @item.IntakeEffectiveDate.Value.ToShortDateString()
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card shadow mb-4">
            <!-- Card Header - Accordion -->
            <a href="#CompletedCollapse" class="d-block card-header bg-success py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="CompletedCollapse">
                <h6 class="m-0 font-weight-bold text-white">Completed</h6>
            </a>
            <!-- Card Content - Collapse -->
            <div class="collapse show" id="CompletedCollapse">
                <div class="card-body" ondrop="dropKanban(event,this)" ondragover="allowDrop(event)" id="Completed" name="success">
                    @foreach (var item in completed)
                    {
                        <div class="card border-left-success shadow p-2 mb-4" draggable="true" ondragstart="drag(event,'success')" id="@item.IntakesId">
                            <small class="badge-secondary float-right p-1" style="border-radius:5px">@item.FkFacilities.FacilityInitials</small>
                            <small class="font-weight-bold d-block">Client</small>
                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.FkClientsId">@item.FkClients.FullName</a>
                            <small class="font-weight-bold d-block">Effective</small>
                            @item.IntakeEffectiveDate.Value.ToShortDateString()
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{

    <!-- Page level plugins -->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/js/demo/datatables-demo.js"></script>

    <!-- CSV Export scripts -->
    <script type="text/javascript" src="~/js/Exports/CSVExport.js"></script>

    <!-- Page level custom scripts starts -->
    <script src="~/js/demo/datatables-demo.js"></script>
    <script>
        $(document).ready(async function() {
            await loadScript("/js/afterLoad.js");
            // Do whatever you want to do after script is ready

            $(".collapse").on('hide.bs.collapse', function(arg) {
                arg.currentTarget.parentElement.parentElement.classList.add('fit-contents');
            });

            $(".collapse").on('show.bs.collapse', function(arg) {
                arg.currentTarget.parentElement.parentElement.classList.remove('fit-contents');
            });

        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
