@model HealthTek_Shared_Libraries.OperatingCounties

<div class="text-center">
    <i class="fas fa-exclamation-triangle fa-5x text-warning pb-2"></i>
    <h5>
        Warning: Deleting this operating county can cause the application to not display certain views. Are you sure you want to delete the operating county <code>@Html.DisplayFor(model => model.County)</code> ?
    </h5>
    <hr />
    <form asp-action="Delete" class="text-right row" asp-route-id="@Model.OperatingCountiesId">
        <input type="text" class="form-control col-md-7 mt-1 ml-2" id="walletName" placeholder="Enter Operating County Title..." name="Name">
        <input type="submit" value="Delete" class="btn btn-danger col-md-4 ml-2 " disabled id="deleteBtn" />
    </form>
</div>

<script>
    $('input[name="Name"]').keyup(function () {
        var Name = @Html.Raw(Json.Serialize(Model.County));
        var name = $(this).val();
        if (Name == name) {
            document.getElementById('deleteBtn').disabled = false;
        } else {
            document.getElementById('deleteBtn').disabled = true;
        }
    });
</script>