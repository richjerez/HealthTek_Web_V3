@model HealthTek_Shared_Libraries.MaladaptiveDischarges

<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Edit" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="MaladaptiveDischargesId" />
                <input type="hidden" asp-for="FkMaladaptivesId" />
                <input type="hidden" asp-for="CreationDate" />
                <input type="hidden" asp-for="LastUpdateDate" />
                <div class="form-group">
                    <label asp-for="DischargeFrequency" class="control-label"></label>
                    <input asp-for="DischargeFrequency" class="form-control" />
                    <span asp-validation-for="DischargeFrequency" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ExpectedDate" class="control-label"></label>
                    <input asp-for="ExpectedDate" class="form-control" type="date"  asp-format="{0:yyy-MM-dd}" />
                    <span asp-validation-for="ExpectedDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DischargeAllStos" class="control-label"></label>
                    <input asp-for="DischargeAllStos" class="form-control" />
                    <span asp-validation-for="DischargeAllStos" class="text-danger"></span>
                </div>
        @{await Html.RenderPartialAsync("~/Views/Shared/_SubmitButton.cshtml","Save");}
            </form>
        </div>
    </div>
</div>
