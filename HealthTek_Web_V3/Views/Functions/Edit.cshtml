@model HealthTek_Shared_Libraries.Functions

<div class="card shadow">
    <div class="card-header py-3">
        <div class="row">
            <div class="col-md-12">
                <form asp-action="Edit" onsubmit="return jQueryAjaxPost(this);">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input asp-for="FkMaladaptivesId" type="hidden" />
                    <input asp-for="FunctionsId" type="hidden" />
                    <input asp-for="CreationDate" type="hidden" />
                    <input asp-for="LastUpdateDate" type="hidden" />
                    <div class="form-group">
                        <label asp-for="FunctionName" class="control-label"></label>
                        <select asp-for="FunctionName" class="ModalSelect" asp-items="ViewBag.Functions"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description" class="control-label"></label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PreventiveStrategies" class="control-label"></label>
                        <textarea asp-for="PreventiveStrategies" class="form-control"></textarea>
                        <span asp-validation-for="PreventiveStrategies" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ManagementStrategies" class="control-label"></label>
                        <textarea asp-for="ManagementStrategies" class="form-control"></textarea>
                        <span asp-validation-for="ManagementStrategies" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ReplacementSkills" class="control-label"></label>
                        <textarea asp-for="ReplacementSkills" class="form-control"></textarea>
                        <span asp-validation-for="ReplacementSkills" class="text-danger"></span>
                    </div>
        @{await Html.RenderPartialAsync("~/Views/Shared/_SubmitButton.cshtml","Save");}
                </form>
            </div>
        </div>
    </div>
</div>

