@model HealthTek_Shared_Libraries.Appointments
<div class="row">
    <div class="col-lg-12">
        <div class="card shadow">
            <!-- Card Content - Collapse -->
            <div class="collapse show" id="collapseCardExample" style="">
                <div class="card-body">
                    <form asp-action="Edit" onsubmit="return jQueryAjaxPost(this);">
                        <input asp-for="AppointmentsId" type="hidden" />
                        <input asp-for="QaStatus" type="hidden" />
                        <input asp-for="BillingStatus" type="hidden" />
                        <input asp-for="FkBaAssessmentsId" type="hidden" />
                        <input asp-for="FkBaMonthlyReportsId" type="hidden" />
                        <input asp-for="FkBaProgressNotesId" type="hidden" />
                        <input asp-for="CreationDate" type="hidden" />
                        <input asp-for="LastFollowUp" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="FkFacilitiesId" class="control-label"></label>
                                    <select asp-for="FkFacilitiesId" class="ModalSelect" asp-items="ViewBag.FkFacilitiesId"></select>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="AppointmentType" class="control-label"></label>
                                    <select asp-for="AppointmentType" class="ModalSelect" asp-items="ViewBag.Types" onchange="getFields()"><option selected disabled>Select Type of Appointment</option></select>
                                </div>
                            </div>
                        </div>
                        @if (Model.AppointmentType == "Services")
                        {
                            <div class="row" id="showHide">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label asp-for="FkServiceCodesId" class="control-label"></label>
                                        <select asp-for="FkServiceCodesId" class="ModalSelect" asp-items="ViewBag.FkServiceCodesId" data-live-search = "true"></select>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label asp-for="FkEmployeesId" class="control-label"></label>
                                        <select asp-for="FkEmployeesId" class="ModalSelect" asp-items="ViewBag.FkEmployeesId" data-live-search = "true"><option selected disabled>Select Employee</option></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" id="client">
                                <label asp-for="FkClientsId" class="control-label"></label>
                                <select asp-for="FkClientsId" class="ModalSelect" asp-items="ViewBag.FkClientsId" onchange="getClientLocations()" data-live-search = "true"><option selected disabled>Select Client</option></select>
                            </div>

                        }
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="StartTime" class="control-label"></label>
                                    <input asp-for="StartTime" class="form-control" />
                                    <span asp-validation-for="StartTime" class="text-danger"></span>
                                </div>
                            </div>
                            @if (Model.AppointmentType == "Services")
                            {
                                <div class="col-lg-6" id="endTime">
                                    <div class="form-group">
                                        <label asp-for="EndTime" class="control-label"></label>
                                        <input asp-for="EndTime" class="form-control" />
                                        <span asp-validation-for="EndTime" class="text-danger"></span>
                                    </div>
                                </div>
                            }

                        </div>
                        @if (Model.AppointmentType == "Services")
                        {
                            <div class="row" id="LocationShowHide">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label asp-for="FkStartLocationId" class="control-label"></label>
                                        <select asp-for="FkStartLocationId" class="ModalSelect" asp-items="ViewBag.FkStartLocationId"></select>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label asp-for="FkEndLocationId" class="control-label"></label>
                                        <select asp-for="FkEndLocationId" class="ModalSelect" asp-items="ViewBag.FkEndLocationId"></select>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <input class="form-check-input" asp-for="IsConfirmed" /> @Html.DisplayNameFor(model => model.IsConfirmed)
                            </label>
                        </div>
                        <div class="form-group">
                            <label asp-for="Description" class="control-label"></label>
                            <textarea asp-for="Description" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <label class="control-label" for="Description" style="display: block;">Style</label>
                        <div class="" style="display: inline-flex;">
                            @{ 
                                string getStyles(string ClassName)
                                {
                                    if (ClassName == Model.ClassName)
                                    {
                                        return "checked";
                                    }
                                    else
                                    {
                                        return "";
                                    }
                                }
                            }
                            @foreach (var i in Model.Styles)
                            {
                                var chk = "";
                                switch (i)
                                {
                                    case "primary":
                                        var ClassName = "bg-primary text-white";
                                        chk = getStyles(ClassName);
                                        break;
                                    case "info":
                                        ClassName = "bg-info text-white";
                                        chk = getStyles(ClassName);
                                        break;
                                    case "warning":
                                        ClassName = "bg-warning text-white";
                                        chk = getStyles(ClassName);
                                        break;
                                    case "danger":
                                        ClassName = "bg-danger text-white";
                                        chk = getStyles(ClassName);
                                        break;
                                    case "success":
                                        ClassName = "bg-success text-white";
                                        chk = getStyles(ClassName);
                                        break;
                                }

                                <div class="bg-@i" style="height: 35px;width: 40px;">
                                    <input type="radio" name="style" value="@i" @chk style="vertical-align: bottom;text-align: center;width: -webkit-fill-available;" />
                                </div>

                            }
                        </div>
                        <div class="clearfix">
                            <div class="float-left mt-3 d-none" id="formSpinner">
                                <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                                <small style="vertical-align: -webkit-baseline-middle;">Form is loading. Please wait until the page reloads</small>
                            </div>

                            <div class="form-group float-right mb-0">
                                <input data-toggle="modal" type="button" value="Cancel Appointment" class="btn btn-danger" onclick="DeleteElement(@Model.AppointmentsId, 'Appointments')" />
                                @if (Model.FkServiceCodes != null)
                                {
                                    switch (Model.FkServiceCodes.CodeTitle)
                                    {
                                        case "BA Assessment":
                                            <input type="button" onclick="LoadEdit(@Model.FkBaAssessmentsId, 'BaAssessments')" value="Access Form" class="btn btn-info" />
                                            break;
                                        case "BA Reassessment":
                                            <input type="button" onclick="LoadEdit(@Model.FkBaReAssessmentsId, 'BaReAssessments')" value="Access Form" class="btn btn-info" />
                                            break;
                                        case "BA Monthly Report":
                                            <input type="button" onclick="LoadEdit(@Model.FkBaMonthlyReportsId, 'BaMonthlyReports')" value="Access Form" class="btn btn-info" />
                                            break;
                                        case "BA Note ABA":
                                        case "BA Note Grp":
                                        case "BA Note LA":
                                        case "BA Note RBT":
                                            <input type="button" onclick="LoadEdit(@Model.FkBaProgressNotesId, 'BaProgressNotes')" value="Access Form" class="btn btn-info" />
                                            break;
                                    }

                                }
                                <input type="submit" value="Update Appointment" class="btn btn-primary" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
                            }
