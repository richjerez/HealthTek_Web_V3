@model HealthTek_Shared_Libraries.Caregivers
@{
    var id = ViewData["ID"];
}

<div class="card shadow mb-4 p-3">
    <!-- Card Header - Accordion -->
    <a href="#collapseCaregivers" class="d-block card-header py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseCaregivers">
        <h6 class="m-0 font-weight-bold text-primary">Caregiver Information</h6>
    </a>
    <!-- Card Content - Collapse -->
    <div class="collapse show" id="collapseCaregivers" style="">
        <div class="card-body">
            @if (Model != null)
            {
                <button class="btn btn-primary float-right" onclick="AddEditElements(@Model.CaregiversId, 'Caregivers')">
                    <i class="fas fa-edit"></i>
                </button>
                <small>Relationship</small>
                <span class="d-block">@Model.Relationship</span>
                <small>FullName</small>
                <span class="d-block">@Model.FullName</span>
                <small>Gender</small>
                <span class="d-block">@Model.Gender</span>
                <small>PhoneNumber</small>
                <span class="d-block">@Model.PhoneNumber</span>
                <small>Address</small>
                @if (Model.Locations != null)
                {
                    <span class="d-block">@Model.Locations.FullLocation</span>
                }
                <small>Comments</small>
                <span class="d-block">@Model.Comments</span>
            }
            else
            {
                <div class="row">
                    <div class="col-lg-12">
                        <button class="btn btn-primary float-right" onclick="AddEditElements(0, 'Caregivers', false, @id)">
                            New Caregiver
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
