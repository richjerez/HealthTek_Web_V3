@model HealthTek_Shared_Libraries.Clients

@{
    ViewData["Title"] = "Client Profile";
    ViewData["ActivePage"] = "Clients";
}
@section Styles{
<!-- Custom styles for this page -->
<link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
<link href='/css/main.css' rel='stylesheet' />
<script src='/js/fullCalendar/main.js' type="text/javascript"></script>
}

<div class="card shadow mb-4">
    <a class="d-block card-header py-3" onclick="LoadEdit('@Model.ClientsId', 'Clients')" href="#">
        <i class="fas fa-user-edit text-primary float-right"></i>
        <h6 class="m-0 font-weight-bold text-primary">Client Profile</h6>
    </a>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-5">
                <h6>
                    Quick Facts
                    <a class="status-@Model.ClientStatus d-inline float-right" data-toggle="modal" data-target="#StatusModal" href="#">@Html.DisplayFor(modelItem => Model.ClientStatus) Client</a>
                </h6>
                <hr>
                <div class="row">
                    <div class="col-lg-12 text-center">
                        <img class="img-profile rounded-block m-auto d-block"
                             src="@Model.AvatarUrl" style="width: 200px;height: 200px;">
                        <hr />
                    </div>

                    <div class="col-lg-12">
                        <div class="row">
                            <div class="col-lg-6">
                                <small class="d-block font-weight-bold">Name</small>
                                <span class="d-block">@Model.FullName</span>
                            </div>
                            <div class="col-lg-6">
                                <small class="d-block font-weight-bold">Chart #</small>
                                    @{
                                    var chart =  "";
                                    if (Model.ClientsFacilities.Count > 0)
                                    {
                                        chart = Model.ClientsFacilities.FirstOrDefault().ChartNumber;
                                    }
                                }
                                <span class="d-block">@chart</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <small class="d-block font-weight-bold">Main Phone</small>
                                <span class="d-block">@Model.MainPhoneNumber</span>
                            </div>
                            <div class="col-lg-6">
                                <small class="d-block font-weight-bold">Alternate Contact Info</small>
                                <span class="d-block">@Model.AlternateContactInfo</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <small class="d-block font-weight-bold">Email</small>
                                <a class="d-block" href="#">@Model.Email</a>
                                <small class="d-block font-weight-bold">Caregiver</small>
                                @if (Model.Caregivers != null)
                                {
                                    <span class="text">@Model.Caregivers.FullName</span>
                                }
                            </div>
                            <div class="col-lg-6">
                                <small class="d-block font-weight-bold">Assignments</small>
                                @foreach (var assignment in Model.Assignments.Where(m => m.AssignmentPosition != null
                                && !m.AssignmentPosition.Contains("Rejected") && m.AssignmentStatus != "Archived"))
                                {
                                    <div>
                                        <a asp-controller="Employees" asp-action="Details"
                                       asp-route-id="@assignment.FkEmployeesId" class="d-inline-block">
                                            @assignment.AssignmentPosition:
                                            @assignment.FkEmployees.FullName
                                        </a>
                                        <span> - @assignment.AssignmentStatus</span>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-lg-1">
                <div class="divider d-none d-sm-block"></div>
            </div>
            <div class="col-lg-6">
                <h6>Dashboard</h6>
                <hr>
                <small class="d-block font-weight-bold">Facilities</small>
                <div>
                    @foreach (var item in Model.ClientsFacilities)
                    {
                        <a class="d-inline-block status-success mr-1 mb-1" style="vertical-align:middle"
                       onclick="AddEditElements(@item.ClientsFacilitiesId, 'ClientsFacilities')" href="#">
                            <small class="d-block font-weight-bold mt-2 text-left">@item.FkFacilities.FacilityInitials</small>
                            <span>@item.FkFacilities.FacilityName</span>
                        </a>
                    }
                    <button onclick="AddEditElements(0, 'ClientsFacilities', false, @Model.ClientsId)" class="btn btn-outline-primary d-print-none mt-0">
                        <span class="text">
                            <i class="fa fa-plus"></i>
                        </span>
                    </button>
                </div>
                <small class="d-block font-weight-bold mt-2">Insurances</small>
                <div>
                    @foreach (var item in Model.ClientInsurances)
                    {
                        <a class="d-inline-block status-success mr-1 mb-1" onclick="AddEditElements(@item.ClientInsurancesId, 'ClientInsurances')" style="vertical-align:middle" href="#"><span>@item.PolicyName</span></a>
                    }
                    <button onclick="AddEditElements(0, 'ClientInsurances', false, @Model.ClientsId)" class="btn btn-outline-primary d-print-none mt-0">
                        <span class="text">
                            <i class="fa fa-plus"></i>
                        </span>
                    </button>
                </div>
                <small class="d-block font-weight-bold">Intakes</small>
                <div>
                    @foreach (var item in Model.Intakes)
                    {
                        <a class="d-inline-block status-@item.IntakeStatus mr-1 mb-1" style="vertical-align:middle" onclick="AddEditElements(@item.IntakesId, 'Intakes')" href="#"><span>@item.IntakeStatus</span></a>
                    }
                    <a onclick="AddEditElements(0, 'Intakes')" class="btn btn-outline-primary d-print-none mt-0">
                        <span class="text">
                            <i class="fa fa-plus"></i>
                        </span>
                    </a>
                </div>
                <small class="d-block font-weight-bold">Authorizations</small>
                <div>
                    @foreach (var item in Model.Authorizations)
                    {
                        <a class="d-inline-block status-@item.AuthorizationStatus mr-1 mb-1"
                       style="vertical-align:middle" onclick="AddEditElements(@item.AuthorizationsId, 'Authorizations')" href="#">
                            <small class="d-block">@item.AuthorizationStatus</small><span>@item.AuthorizationNumber</span>
                        </a>
                    }
                    <a onclick="AddEditElements(0, 'Authorizations', false, @Model.ClientsId)" class="btn btn-outline-primary d-print-none mt-0">
                        <span class="text">
                            <i class="fa fa-plus"></i>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Nav tabs -->
<ul class="nav nav-tabs" id="myTab" role="tablist" style="float: none!important;">
    @foreach (var item in ViewBag.Tabs)
    {
        <li class="nav-item">
            <a class="nav-link @item.Active" asp-action="Details" asp-route-id="@Model.ClientsId" asp-route-TabName="@item.Name">@item.Name</a>
        </li>
    }
</ul>
<!-- Tab panes -->
<div class="tab-content">
    <div class="tab-pane active" id="@ViewBag.TableName" role="tabpanel" aria-labelledby="home-tab">
        <partial name="@ViewBag.TableName" model="@ViewBag.Table" />
    </div>
</div>

<!-- Status Modal-->
<div class="modal fade" id="StatusModal" tabindex="-1" role="dialog" aria-labelledby="StatusModalLabel"
     aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content bg-white text-dark">
            <div class="modal-header">
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
                <h5 class="modal-title" id="StatusModalLabel">Manage Client</h5>
                <h6>Client Status</h6>
            </div>
            <div class="modal-body">
                <div class="card shadow p-3">
                    <form asp-action="ChangeClientStatus" method="post">
                        <input type="hidden" asp-for="ClientsId" />
                        <div class="form-group">
                            <label asp-for="ClientStatus" class="control-label"></label>
                            <select asp-for="ClientStatus" class="form-control" asp-items="ViewBag.ClientStatus"></select>
                        </div>
                        <div class="form-group m-r-20 text-md-right mb-0">
                            <input type="submit" id="submitBtn" value="Save" class="btn btn-primary" />
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{

<!-- Page level plugins -->
<script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
<script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

<!-- Page level custom scripts -->
<script src="~/js/demo/datatables-demo.js"></script>
<!-- CSV Export scripts -->
<script type="text/javascript" src="~/js/Exports/CSVExport.js"></script>
<script src="/js/Cruds/Appointments.js"></script>

<!-- Page level custom scripts starts -->
<script src="~/js/demo/datatables-demo.js"></script>
<script>
    $(document).ready(async function () {
        await loadScript("/js/afterLoad.js");
    });
</script>
}
