@model IEnumerable<HealthTek_Shared_Libraries.Comments>
@{ 
    var id = ViewData["ID"];
}
<div class="card shadow mb-4 p-3">
    <!-- Card Header - Accordion -->
    <a href="#collapseComments" class="d-block card-header py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseComments">
        <h6 class="m-0 font-weight-bold text-primary">Comments</h6>
    </a>
    <!-- Card Content - Collapse -->
    <div class="collapse show" id="collapseComments" style="">
        <div class="card-body">
            <button class="btn btn-primary float-right" onclick="AddEditElements(0, 'Comments', false,@id)">
                New Comment
            </button>
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>Date</th>
                            <th>Employee</th>
                            <th>Comment</th>
                            <th data-orderable="false" class="d-print-none"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                        <tr ondblclick="AddEditElements(@item.CommentsId,'Comments')">
                            <td>
                                @Html.DisplayFor(modelItem => item.NoteDate)
                            </td>
                            <td>
                                <a asp-controller="Employees" asp-action="Details" asp-route-id="@item.FkEmployees.EmployeesId">
                                    @Html.DisplayFor(modelItem => item.FkEmployees.EmployeeLabel)
                                </a>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Notes)
                            </td>
                            <td class="text-right d-print-none">
                                <button onclick="DeleteElement('@item.CommentsId', 'Comments')" href="#" class="btn btn-outline-danger ">
                                    <span class="text">
                                        <i class="fa fa-trash"></i>
                                    </span>
                                </button>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

