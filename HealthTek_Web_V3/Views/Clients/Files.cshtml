@model IEnumerable<HealthTek_Shared_Libraries.Documents>
<div class="card shadow mb-4 p-3">
    <!-- Card Header - Accordion -->
    <a href="#collapseFiles" class="d-block card-header py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseFiles">
        <h6 class="m-0 font-weight-bold text-primary">Files</h6>
    </a>
    <!-- Card Content - Collapse -->
    <div class="collapse show" id="collapseFiles" style="">
        <div class="card-body">
            <button class="btn btn-primary float-right" onclick="AddEditElements(0, 'FileDropbox')">
                Upload File
            </button>
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>
                                Uploaded On
                            </th>
                            <th>
                                Uploaded By
                            </th>
                            <th>
                                Title
                            </th>
                            <th data-orderable="false"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr ondblclick="LoadEdit(@item.DocumentsId, 'Documents')">
                                <td>
                                    @Html.DisplayFor(modelItem => item.CreationDate)
                                </td>
                                <td>
                                    @if (item.FkUploadedBy != null)
                                    {
                                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@item.FkUploadedBy.EmployeesId">
                                            @Html.DisplayFor(modelItem => item.FkUploadedBy.EmployeeLabel)
                                        </a>

                                    }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DocumentTitle)
                                </td>
                                <td class="text-right">
                                    <a href="/files/@item.DocumentUrl" class="btn btn-outline-primary d-print-none" download>
                                        <span class="text">
                                            <i class="fa fa-download"></i>
                                        </span>
                                    </a>
                                    <a asp-controller="Documents" asp-action="Details" asp-route-id="@item.DocumentsId" asp-route-returnUrl="Index" class="btn btn-outline-info d-print-none">
                                        <span class="text">
                                            <i class="fa fa-server"></i>
                                        </span>
                                    </a>
                                    <button onclick="DeleteElement(@item.DocumentsId, 'Documents', 'Clients/Details/@item.FkEmployeesId')" class="btn btn-outline-danger d-print-none">
                                        <span class="text">
                                            <i class="fa fa-trash"></i>
                                        </span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

