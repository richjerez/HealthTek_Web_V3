@model HealthTek_Shared_Libraries.ClientInsurances

<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Edit" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="CreationDate" type="hidden" />
                <input type="hidden" asp-for="ClientInsurancesId" />
                <span class="d-block text-center">@Model.FkClients.FullName</span>
                <span class="d-block text-center">@Model.FkClients.ClientsFacilities.FirstOrDefault().ClientsFacilitiesId</span>
                <span class="d-block text-center">@Model.FkClients.ClientsFacilities.FirstOrDefault().ChartNumber</span>
                <span class="d-block text-center">@Model.FkClients.Dob.Value.ToShortDateString()</span>

                <div class="form-group">
                    <label asp-for="PolicyName" class="control-label"></label>
                    <select asp-for="PolicyName" class="form-control" asp-items="ViewBag.Policies" data-live-search = "true"></select>
                    <span asp-validation-for="PolicyName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PolicyStatus" class="control-label"></label>
                    <select asp-for="PolicyStatus" class="form-control" asp-items="ViewBag.Status"></select>
                    <span asp-validation-for="PolicyStatus" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PolicyIdentifier" class="control-label"></label>
                    <input asp-for="PolicyIdentifier" class="form-control" />
                    <span asp-validation-for="PolicyIdentifier" class="text-danger"></span>
                </div>
                <div class="form-group form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="IsVerified" /> <small style="vertical-align:sub">Is This Insurance Verified?</small>
                    </label>
                </div>
                <div class="form-group float-right">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>
