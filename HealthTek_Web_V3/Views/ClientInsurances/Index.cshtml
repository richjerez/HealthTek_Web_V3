@model IEnumerable<HealthTek_Shared_Libraries.ClientInsurances>
@{
    ViewData["Title"] = "Insurance Checks";
    ViewData["ActivePage"] = "ClientInsurances";
}
@section Styles{
    <!-- Custom styles for this page -->
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">

    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/css/bootstrap-select.min.css">

    <!-- Latest compiled and minified JavaScript -->
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/js/bootstrap-select.min.js"></script>
}

<div class="">
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-4">
                    <h6 class="m-0 font-weight-bold text-primary datatitle">
                        @ViewData["Title"]<i class="fa fa-plus float-right d-md-none d-sm-block" style="color: gray;" ></i>
                    </h6>
                </div>
                <div class="col-md-8 text-right">
                    <a onclick="AddEditElements(0, 'ClientInsurances')" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus fa-sm text-white-50"></i>
                        </span>
                        <span class="text">New @ViewData["Title"]</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="window.print()">
                        <span class="icon text-white-50">
                            <i class="fas fa-print fa-sm text-white-50"></i>
                        </span>
                        <span class="text">Print</span>
                    </a>
                    <a class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" asp-controller="Report" asp-action="Get" asp-route-ClassName="ClientInsurances" style="margin:0">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-pdf fa-sm text-white-50"></i>
                        </span>
                        <span class="text">PDF</span>
                    </a>
                    <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm btn-icon-split d-print-none" style="margin:0" onclick="ExportCSV('ClientInsurances',7)">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-csv fa-sm text-white-50"></i>
                        </span>
                        <span class="text">CSV</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>
                                Chart Number
                            </th>
                            <th>
                                Patient Name
                            </th>
                            <th>
                                Date of Birth
                            </th>
                            <th>
                                Policy
                            </th>
                            <th>
                                Policy Number
                            </th>
                            <th>
                                Status
                            </th>
                            <th>
                                Effective Date
                            </th>
                            <th data-orderable="false"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr ondblclick="AddEditElements(@item.ClientInsurancesId,'ClientInsurances')">
                                <td>
                                    @Html.DisplayFor(modelItem => item.FkClients.ClientsFacilities.FirstOrDefault().ChartNumber)
                                </td>
                                <td>
                                    <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.FkClientsId">@item.FkClients.FullName</a>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.FkClients.Dob)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PolicyName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PolicyIdentifier)
                                </td>
                                <td>
                                    <a class="status-@item.PolicyStatus">@Html.DisplayFor(modelItem => item.PolicyStatus)</a>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.EffectiveDate)
                                </td>
                                <td class="text-right">
                                    @if (!item.IsVerified)
                                    {
                                        <a asp-action="Verify" asp-route-id="@item.ClientInsurancesId" class="btn btn-outline-primary d-print-none">
                                            <span class="text">
                                                <i class="fa fa-check"></i>
                                            </span>
                                        </a>

                                    }
                                    else
                                    {
                                        <a class="status-success" href="#">Verified</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{

    <!-- Page level plugins -->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/js/demo/datatables-demo.js"></script>

    <!-- CSV Export scripts -->
    <script type="text/javascript" src="~/js/Exports/CSVExport.js"></script>

}
