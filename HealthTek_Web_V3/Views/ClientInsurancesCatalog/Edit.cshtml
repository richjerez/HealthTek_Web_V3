@model HealthTek_Shared_Libraries.ClientInsurancesCatalog

<div class="container">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-12">
                    <form asp-action="Edit" onsubmit="return jQueryAjaxPost(this);">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input asp-for="CreationDate" type="hidden" />
                        <input type="hidden" asp-for="ClientInsurancesCatalogId" />
                        <div class="form-group">
                            <label asp-for="PolicyName" class="control-label"></label>
                            <input asp-for="PolicyName" class="form-control" />
                            <span asp-validation-for="PolicyName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="PolicyProgram" class="control-label"></label>
                            <input asp-for="PolicyProgram" class="form-control" />
                            <span asp-validation-for="PolicyProgram" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Save" class="btn btn-primary float-right" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

