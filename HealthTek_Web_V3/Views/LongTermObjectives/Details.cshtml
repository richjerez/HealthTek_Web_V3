@model HealthTek_Shared_Libraries.LongTermObjectives
@{
    var ParentId = 0;
    switch (Model.LtoType)
    {
        case "Maladaptive":
            if (Model.FkMaladaptives != null) { ParentId = Model.FkMaladaptives.MaladaptivesId; }
            break;
        case "Replacement":
            if (Model.FkReplacements != null) { ParentId = Model.FkReplacements.ReplacementsId; }
            break;
        case "CTG-R":
        case "CTG-I":
        case "CTG-M":
            if (Model.FkCaregiverTrainingGoals != null)
            { ParentId = Model.FkCaregiverTrainingGoalsId.Value; }
            break;
    }
}

<div id="hideLTO+@Model.LongTermObjectivesId">
    <div class="row">
        <div class="col-lg-10 border-right">
            <small class="d-block font-weight-bold">Current-LTO (LTO# @Model.ObjectiveNumber)</small>
            <span>@Model.Description</span>
            <div class="dropdown d-inline-block">
                <button class="btn btn-primary btn-xs dropdown-toggle" type="button" 
                id="dropdownMenu-@Model.LongTermObjectivesId" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    @Model.LtoStatus
                    <i class="fas fa-edit"></i>
                </button>
                <div class="dropdown-menu animated--fade-in" aria-labelledby="dropdownMenu-@Model.LongTermObjectivesId">
                    @foreach (var status in ViewBag.STOStatus)
                    {
                        <a class="dropdown-item" asp-controller="LongTermObjectives"
                       asp-action="ChangeStatus" asp-route-id="@Model.LongTermObjectivesId"
                       asp-route-status="@status.Text">@status.Text</a>
                    }
                </div>
            </div>
        </div><div class="col-lg-2 text-center pt-3">
            <a onclick="AddEditElements(@Model.LongTermObjectivesId, 'LongTermObjectives',false, @ParentId, '@Model.LtoType')" class="btn btn-primary btn-xs mx-1" tabindex="0">
                <i class="fas fa-edit"></i>
            </a><a onclick="DeleteElement(@Model.LongTermObjectivesId, 'LongTermObjectives')" class="btn btn-danger btn-xs mx-1" style="width:35px"><i class="fas fa-trash"></i></a>
        </div>
    </div>
</div>
<hr />