@model HealthTek_Shared_Libraries.ReplacementMeasurements
<div class="card shadow p-3">
    <div class="row">
    <div class="col-md-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReplacementMeasurementsId" />
            <input type="hidden" asp-for="CreationDate" />
            <input type="hidden" asp-for="LastUpdateDate" />
            <input type="hidden" asp-for="ReplacementMeasurementsId" />
            <input type="hidden" asp-for="FkReplacementsId" />
            <input type="hidden" asp-for="DateMeasured" />
                <div class="form-group">
                    <label asp-for="FkReplacements.ReplacementName" class="control-label"></label>
                    <input asp-for="FkReplacements.ReplacementName" class="form-control" disabled />
                </div>
                <div class="form-group d-none" id="successfulTrials">
                    <label asp-for="SuccessfulTrials" class="control-label"></label>
                    <input asp-for="SuccessfulTrials" class="form-control" />
                    <span asp-validation-for="SuccessfulTrials" class="text-danger"></span>
                </div>
                <div class="form-group d-none" id="totalTrials">
                    <label asp-for="TotalTrials" class="control-label"></label>
                    <input asp-for="TotalTrials" class="form-control" />
                    <span asp-validation-for="TotalTrials" class="text-danger"></span>
                </div>
                <div class="form-group d-none" id="duration">
                    <label asp-for="Duration" class="control-label"></label>
                    <input asp-for="Duration" class="form-control" />
                    <span asp-validation-for="Duration" class="text-danger"></span>
                </div>
                <div class="form-group d-none" id="durationunit">
                    <label asp-for="DurationUnit" class="control-label"></label>
                    <select asp-for="DurationUnit" class="form-control" asp-items="ViewBag.TimeFrame">
                        <option disabled selected>Select Duration Unit</option>
                    </select>
                    <span asp-validation-for="DurationUnit" class="text-danger"></span>
                </div>
            <div class="form-group">
                <label asp-for="ReplacementMeasureComment" class="control-label"></label>
                <textarea asp-for="ReplacementMeasureComment" class="form-control"></textarea>
                <span asp-validation-for="ReplacementMeasureComment" class="text-danger"></span>
            </div>
        @{await Html.RenderPartialAsync("~/Views/Shared/_SubmitButton.cshtml","Save");}
        </form>
    </div>
</div>
</div>
<script>
    var freq = '@Html.Raw(Model.FkReplacements.CollectionMethod)';
    changeFreq(freq);
</script>