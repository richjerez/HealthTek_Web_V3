@model HealthTek_Shared_Libraries.ShortTermObjectives

@{
    var ParentId = 0;
    switch (Model.StoType)
    {
        case "Maladaptive":
            if (Model.FkMaladaptives != null) { ParentId = Model.FkMaladaptives.MaladaptivesId; }
            break;
        case "Replacement":
            if (Model.FkReplacements != null) { ParentId = Model.FkReplacements.ReplacementsId; }
            break;
        case "CTG-R":
        case "CTG-I":
        case "CTG-M":
            if (Model.FkCaregiverTrainingGoals != null)
            { ParentId = Model.FkCaregiverTrainingGoalsId.Value; }
            break;
    }
}

<div id="hideLTO+@Model.ShortTermObjectivesId">
    <div class="row">
        <div class="col-lg-10 border-right">
            <small class="d-block font-weight-bold">Current-STO (STO# @Model.ObjectiveNumber)</small>
            <span>@Model.Description -</span>
            <div class="dropdown d-inline-block">
                <button class="btn btn-primary btn-xs dropdown-toggle" type="button" 
                id="dropdownMenu-@Model.ShortTermObjectivesId" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    @Model.StoStatus
                    <i class="fas fa-edit"></i>
                </button>
                <div class="dropdown-menu animated--fade-in" aria-labelledby="dropdownMenu-@Model.ShortTermObjectivesId">
                    @foreach (var status in ViewBag.STOStatus)
                    {
                        <a class="dropdown-item" onclick="changeSTOStatus(@Model.ShortTermObjectivesId,'@status.Text',this)">@status.Text</a>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-2 text-center pt-3">
            <a onclick="AddEditElements(@Model.ShortTermObjectivesId, 'ShortTermObjectives', false, @ParentId, '@Model.StoType')" class="btn btn-primary btn-xs mx-1" tabindex="0">
                <i class="fas fa-edit"></i>
            </a><a onclick="DeleteObjective(@Model.ShortTermObjectivesId, 'ShortTermObjectives')" class="btn btn-danger btn-xs mx-1" style="width:35px"><i class="fas fa-trash"></i></a>
        </div>
    </div>
</div>
<hr />