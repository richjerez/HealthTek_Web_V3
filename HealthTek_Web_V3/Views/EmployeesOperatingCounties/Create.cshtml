@model HealthTek_Shared_Libraries.EmployeesOperatingCounties

<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Create" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="FkEmployeesId" type="hidden"/>
                <div class="form-group">
                    <label asp-for="FkOperatingCountiesId" class="control-label"></label>
                    <select asp-for="FkOperatingCountiesId" class="form-control" asp-items="ViewBag.FkOperatingCountiesId" data-live-search="true"></select>
                </div>
                <div class="form-group float-right mb-0">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>
