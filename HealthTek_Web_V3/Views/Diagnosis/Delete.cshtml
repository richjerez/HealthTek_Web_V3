@model HealthTek_Shared_Libraries.Diagnosis

<div class="text-center">
    <i class="fas fa-exclamation-triangle fa-5x text-warning pb-2"></i>
    <h5>
        Warning: This will permanently delete this Diagnosis for this client.
        Are you sure you want to delete the client diagnosis <code>@Html.DisplayFor(model => model.DiagnosisName)</code> ?
    </h5>
    <hr />
    <form asp-action="Delete" class="text-right row" asp-route-id="@Model.DiagnosisId">
        <input type="text" class="form-control col-md-7 mt-1 ml-2" id="asName" placeholder="Enter Diagnosis Name..." name="Name">
        <input type="submit" value="Delete" class="btn btn-danger col-md-4 ml-2 " disabled id="deleteBtn" />
    </form>
</div>
<script>
    $('input[name="Name"]').keyup(function () {
        var Name = @Html.Raw(Json.Serialize(Model.DiagnosisName));
        var name = $(this).val();
        if (Name == name) {
            document.getElementById('deleteBtn').disabled = false;
        } else {
            document.getElementById('deleteBtn').disabled = true;
        }
    });
</script>