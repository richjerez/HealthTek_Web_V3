@model string
<div class="clearfix">
       <div class="float-left mt-3 d-none" id="formSpinner">
        <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
        <small style="vertical-align: -webkit-baseline-middle;">Loading. Please wait until the page reloads</small>
    </div>
 <div class="form-group float-right mb-0">
        <button type="submit" id="submitBtn" class="btn btn-primary">@Model</button>
    </div>
</div>
