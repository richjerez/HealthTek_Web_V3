    <script>
        var cookieValueFromContext  = @Html.Raw(Json.Serialize(Context.Request.Cookies["Theme"]));

        if (cookieValueFromContext != null) {
            cookieValueFromContext = cookieValueFromContext.substring(0, cookieValueFromContext.indexOf("."));
        } else {
            cookieValueFromContext = "primary";
        }
        var input = document.getElementById("theme");
        switch (cookieValueFromContext) {
            case "primary":
                input.checked = false;
                break;
            case "dark":
                input.checked = true;
                break;
        }

        function getCssClass() {
            var cookieValue = @Html.Raw(Json.Serialize(Context.Request.Cookies["Theme"]));
            if (cookieValue != null) {
                cookieValue = cookieValue.substring(0, cookieValue.indexOf("."));
            } else {
                cookieValue = "primary";
            }
        var url = "/Home/SetThemeCookie";
        var userTheme = "";
            switch (cookieValue) {
            case "primary":
                userTheme = "dark"
                break;
                case "dark":
                userTheme = "primary"
                break;

        }
            PushThemeCookies(url, userTheme);
            var theme = document.getElementById('cssSelector');
        // Change the value of href attribute
        // to change the css sheet.
        theme.setAttribute('href', '/css/' + userTheme + '.css');
        }

    </script>

    <script src="/js/Cruds/Appointments.js"></script>
