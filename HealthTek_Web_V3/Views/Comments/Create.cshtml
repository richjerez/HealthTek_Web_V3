@model HealthTek_Shared_Libraries.Comments
<div class="card shadow p-3">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Create" onsubmit="return jQueryAjaxPost(this);">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="FkClientsId" type="hidden" value="@ViewBag.FkClientsId" />
                <div class="form-group">
                    <label asp-for="NoteDate" class="control-label"></label>
                    <input asp-for="NoteDate" class="form-control" type="date" asp-format="{0:yyy-MM-dd}" />
                    <span asp-validation-for="NoteDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Notes" class="control-label"></label>
                    <textarea asp-for="Notes" class="form-control" ></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
                <div class="form-group float-right mb-0">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>